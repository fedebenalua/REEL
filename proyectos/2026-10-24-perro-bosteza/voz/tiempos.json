{
  "firma": "4e50e8e8eaf9",
  "duracion": 33.04,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro bosteza cuando bostezas tú?",
      "clave": "bosteza",
      "inicio": 0,
      "fin": 2.88
    },
    {
      "n": 2,
      "texto": "No es que le entre el sueño: le salta el tuyo.",
      "clave": "salta",
      "inicio": 2.96,
      "fin": 6
    },
    {
      "n": 3,
      "texto": "Si solo abres la boca, la mitad. Si el bostezo es de verdad, el doble.",
      "clave": "doble",
      "inicio": 6.08,
      "fin": 10.64
    },
    {
      "n": 4,
      "texto": "Parecía cariño, porque contigo le entraba más.",
      "clave": "cariño",
      "inicio": 10.68,
      "fin": 13.84
    },
    {
      "n": 5,
      "texto": "Al juntar los estudios, con un extraño le entra igual.",
      "clave": "extraño",
      "inicio": 13.92,
      "fin": 17.2
    },
    {
      "n": 6,
      "texto": "Y le da igual que le acaricies o que pases de largo.",
      "clave": "largo",
      "inicio": 17.24,
      "fin": 20
    },
    {
      "n": 7,
      "texto": "Ni el cariño ni la tensión lo explican del todo.",
      "clave": "tensión",
      "inicio": 20.04,
      "fin": 22.96
    },
    {
      "n": 8,
      "texto": "Así que te copia el bostezo, y un te quiero no está demostrado.",
      "clave": "quiero",
      "inicio": 23.04,
      "fin": 27.28
    },
    {
      "n": 9,
      "texto": "Envíaselo a ese amigo al que su perro le bosteza en la cara y él se lo toma por un te quiero.",
      "clave": "cara",
      "inicio": 27.4,
      "fin": 32.24
    }
  ],
