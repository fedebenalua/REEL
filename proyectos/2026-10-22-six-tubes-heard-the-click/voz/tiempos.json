  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote once made the TV a third more expensive.",
      "clave": "expensive",
      "inicio": 0,
      "fin": 4.16
    },
    {
      "n": 2,
      "texto": "The remote was just a hammer hitting a metal rod.",
      "clave": "hammer",
      "inicio": 4.2,
      "fin": 7.04
    },
    {
      "n": 3,
      "texto": "The costly part was six glass tubes inside the TV.",
      "clave": "tubes",
      "inicio": 7.12,
      "fin": 10.56
    },
    {
      "n": 4,
      "texto": "That sound is too high for you to hear, so the tubes were the ear.",
      "clave": "hear",
      "inicio": 10.64,
      "fin": 14.56
    },
    {
      "n": 5,
      "texto": "Those six tubes added about a third to the price.",
      "clave": "third",
      "inicio": 14.68,
      "fin": 17.68
    },
    {
      "n": 6,
      "texto": "Later those tubes shrank down to a tiny chip.",
      "clave": "chip",
      "inicio": 17.92,
      "fin": 20.8
    },
    {
      "n": 7,
      "texto": "And that sound became a light you can't see.",
      "clave": "light",
      "inicio": 20.84,
      "fin": 23.44
    },
    {
      "n": 8,
      "texto": "That light needs batteries.",
      "clave": "batteries",
      "inicio": 23.52,
      "fin": 25.12
    },
    {
      "n": 9,
      "texto": "The old hammer never did.",
      "clave": "never",
      "inicio": 25.16,
      "fin": 26.72
    },
    {
      "n": 10,
      "texto": "Now your phone is the remote.",
      "clave": "phone",
      "inicio": 26.8,
      "fin": 28.72
    },
    {
      "n": 11,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 28.8,
      "fin": 30.56
    },
    {
      "n": 12,
      "texto": "Send it to that friend who keeps buying batteries.",
      "clave": "friend",
      "inicio": 30.64,
      "fin": 33.2
    }
  ],
