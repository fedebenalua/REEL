{
  "firma": "acdab55ebae5",
  "duracion": 47.36,
  "frases": [
    {
      "n": 1,
      "texto": "That black line in your bathroom caulk is mold.",
      "clave": "mold",
      "inicio": 0,
      "fin": 2.64
    },
    {
      "n": 2,
      "texto": "A wipe cleans the surface. The black inside stays.",
      "clave": "inside",
      "inicio": 2.96,
      "fin": 6.4
    },
    {
      "n": 3,
      "texto": "Water sits in the seam, so the mold grows down through it.",
      "clave": "seam",
      "inicio": 6.64,
      "fin": 9.6
    },
    {
      "n": 4,
      "texto": "Bigger than three feet by three feet? Call a pro.",
      "clave": "pro",
      "inicio": 10.08,
      "fin": 12.48
    },
    {
      "n": 5,
      "texto": "Open a window. Gloves, goggles, and an N95 mask.",
      "clave": "mask",
      "inicio": 12.8,
      "fin": 16.64
    },
    {
      "n": 6,
      "texto": "Score both edges with a utility knife, and pull the caulk out.",
      "clave": "pull",
      "inicio": 17.04,
      "fin": 20.24
    },
    {
      "n": 7,
      "texto": "Scrub the gap with soapy water, then wipe with rubbing alcohol.",
      "clave": "alcohol",
      "inicio": 20.72,
      "fin": 23.96
    },
    {
      "n": 8,
      "texto": "Let it dry all the way. If the wall feels soft, stop.",
      "clave": "soft",
      "inicio": 24.16,
      "fin": 27.84
    },
    {
      "n": 9,
      "texto": "Tape both sides, and run a thin bead of mold-resistant silicone.",
      "clave": "silicone",
      "inicio": 28.4,
      "fin": 31.84
    },
    {
      "n": 10,
      "texto": "Smooth it with a gloved finger, and peel the tape.",
      "clave": "finger",
      "inicio": 32.32,
      "fin": 34.64
    },
    {
      "n": 11,
      "texto": "Stay out until the time on the tube. Often a full day.",
      "clave": "day",
      "inicio": 35.12,
      "fin": 38.08
    },
    {
      "n": 12,
      "texto": "Squeegee the glass and run the fan, or it comes right back.",
      "clave": "fan",
      "inicio": 38.56,
      "fin": 41.52
    },
    {
      "n": 13,
      "texto": "Want the full step-by-step for any problem at home? Our tool is in the link in bio.",
      "clave": "bio",
      "inicio": 42.08,
      "fin": 46.56
    }
  ],
