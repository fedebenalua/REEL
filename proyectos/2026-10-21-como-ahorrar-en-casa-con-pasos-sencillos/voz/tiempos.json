{
  "firma": "e694d21dfeb2",
  "duracion": 46.56,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que tu lavadora no gasta la luz en lavar, sino en calentar el agua?",
      "clave": "calentar",
      "inicio": 0,
      "fin": 4.48
    },
    {
      "n": 2,
      "texto": "Y no es lo único que pagas sin darte cuenta. Cuatro pasos para gastar menos en casa.",
      "clave": "cuatro",
      "inicio": 4.56,
      "fin": 9.84
    },
    {
      "n": 3,
      "texto": "Uno: lava en frío. De cada diez euros de luz de tu lavadora, ocho se van en calentar el agua.",
      "clave": "frío",
      "inicio": 9.96,
      "fin": 16.24
    },
    {
      "n": 4,
      "texto": "Dos: baja un grado la calefacción. Cada grado de más es un siete por ciento más de gasto.",
      "clave": "grado",
      "inicio": 16.4,
      "fin": 22.56
    },
    {
      "n": 5,
      "texto": "Tres: enchufa la tele y todo lo de alrededor a un ladrón con interruptor, y apágalo por la noche. Más de cuarenta euros al año.",
      "clave": "ladrón",
      "inicio": 22.667,
      "fin": 30.8
    },
    {
      "n": 6,
      "texto": "Cuatro: usa la olla a presión. Mantener el agua hirviendo le cuesta casi seis veces menos que a una olla abierta.",
      "clave": "presión",
      "inicio": 30.84,
      "fin": 37.76
    },
    {
      "n": 7,
      "texto": "No hace falta pasar frío ni cambiar de casa: solo dejar de pagar lo que no usas.",
      "clave": "usas",
      "inicio": 37.8,
      "fin": 42.56
    },
    {
      "n": 8,
      "texto": "Envíaselo a ese amigo que pone la lavadora a noventa grados.",
      "clave": "noventa",
      "inicio": 42.64,
      "fin": 45.76
    }
  ],
