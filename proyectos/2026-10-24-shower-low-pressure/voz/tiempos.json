{
  "firma": "2eb713f83cba",
  "duracion": 51.04,
  "frases": [
    {
      "n": 1,
      "texto": "Why is your shower just a trickle?",
      "clave": "trickle",
      "inicio": 0,
      "fin": 2.16
    },
    {
      "n": 2,
      "texto": "The holes are packed with white chalk, so the water can't get out.",
      "clave": "chalk",
      "inicio": 2.24,
      "fin": 5.76
    },
    {
      "n": 3,
      "texto": "Open the sink. If that blasts, the clog is in the showerhead.",
      "clave": "sink",
      "inicio": 5.84,
      "fin": 9.84
    },
    {
      "n": 4,
      "texto": "If only the hot side is weak, leave the water heater alone.",
      "clave": "heater",
      "inicio": 9.92,
      "fin": 13.6
    },
    {
      "n": 5,
      "texto": "Hold the arm still. A cloth if it's stuck, then twist the head to the left.",
      "clave": "left",
      "inicio": 13.72,
      "fin": 18.56
    },
    {
      "n": 6,
      "texto": "If the arm starts turning, stop, and call a plumber.",
      "clave": "stop",
      "inicio": 18.6,
      "fin": 22.16
    },
    {
      "n": 7,
      "texto": "Soak the head in white vinegar, holes down, for one hour.",
      "clave": "vinegar",
      "inicio": 22.24,
      "fin": 25.813
    },
    {
      "n": 8,
      "texto": "A thick crust can sit overnight. Gold or brass: thirty minutes only.",
      "clave": "thirty",
      "inicio": 25.867,
      "fin": 30.72
    },
    {
      "n": 9,
      "texto": "Scrub the holes with an old toothbrush, and rinse.",
      "clave": "toothbrush",
      "inicio": 30.8,
      "fin": 33.68
    },
    {
      "n": 10,
      "texto": "Screw it back on to the right, by hand.",
      "clave": "right",
      "inicio": 33.76,
      "fin": 36.213
    },
    {
      "n": 11,
      "texto": "The spray comes roaring back. Once a month, the same soak keeps the chalk away.",
      "clave": "spray",
      "inicio": 36.267,
      "fin": 41.413
    },
    {
      "n": 12,
      "texto": "If every tap is weak, open the main valve all the way. Already open? Call a plumber.",
      "clave": "valve",
      "inicio": 41.467,
      "fin": 47.32
    },
    {
      "n": 13,
      "texto": "Send this to that friend whose shower barely dribbles.",
      "clave": "friend",
      "inicio": 47.36,
      "fin": 50.24
    }
  ],
