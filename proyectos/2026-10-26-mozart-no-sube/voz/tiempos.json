{
  "firma": "284a8acb46ed",
  "duracion": 55.68,
  "frases": [
    {
      "n": 1,
      "texto": "Diez minutos de Mozart, y el cociente sube ocho puntos.",
      "clave": "ocho",
      "inicio": 0,
      "fin": 3.64
    },
    {
      "n": 2,
      "texto": "Lo publicaron en una revista de verdad.",
      "clave": "revista",
      "inicio": 3.84,
      "fin": 5.76
    },
    {
      "n": 3,
      "texto": "¿Qué les pusieron delante, en realidad?",
      "clave": "delante",
      "inicio": 6.16,
      "fin": 8.32
    },
    {
      "n": 4,
      "texto": "Treinta y seis personas, y cada una pasó por las tres.",
      "clave": "seis",
      "inicio": 8.36,
      "fin": 11.68
    },
    {
      "n": 5,
      "texto": "Diez minutos de una sonata a dos pianos.",
      "clave": "sonata",
      "inicio": 11.76,
      "fin": 14.12
    },
    {
      "n": 6,
      "texto": "Otros diez, una voz que solo decía: relájate.",
      "clave": "relájate",
      "inicio": 14.32,
      "fin": 17.52
    },
    {
      "n": 7,
      "texto": "Y otros diez, sentados en silencio.",
      "clave": "silencio",
      "inicio": 18,
      "fin": 20
    },
    {
      "n": 8,
      "texto": "Después, un folio: lo doblas en la cabeza y adivinas los agujeros.",
      "clave": "folio",
      "inicio": 20.56,
      "fin": 24.88
    },
    {
      "n": 9,
      "texto": "Ese folio salió ocho o nueve puntos por encima.",
      "clave": "encima",
      "inicio": 25.12,
      "fin": 28.4
    },
    {
      "n": 10,
      "texto": "Ciento diecinueve, contra ciento diez en silencio.",
      "clave": "diecinueve",
      "inicio": 28.44,
      "fin": 31.36
    },
    {
      "n": 11,
      "texto": "A los quince minutos, el salto ya no estaba.",
      "clave": "quince",
      "inicio": 31.92,
      "fin": 34.24
    },
    {
      "n": 12,
      "texto": "No era el cociente entero. Eran juegos de espacio.",
      "clave": "espacio",
      "inicio": 34.64,
      "fin": 37.6
    },
    {
      "n": 13,
      "texto": "Un cuento que te guste hace un salto parecido.",
      "clave": "cuento",
      "inicio": 38.08,
      "fin": 40.32
    },
    {
      "n": 14,
      "texto": "Casi cuarenta estudios, y más de tres mil personas.",
      "clave": "cuarenta",
      "inicio": 40.72,
      "fin": 43.92
    },
    {
      "n": 15,
      "texto": "Mozart apenas se separaba de otra música.",
      "clave": "apenas",
      "inicio": 44.4,
      "fin": 46.64
    },
    {
      "n": 16,
      "texto": "Esos ocho puntos eran ese juego, un cuarto de hora y el ánimo.",
      "clave": "ánimo",
      "inicio": 47.04,
      "fin": 51.6
    },
    {
      "n": 17,
      "texto": "Si quieres ver tu cociente, está en la app del enlace de la bio.",
      "clave": "cociente",
      "inicio": 51.64,
      "fin": 54.88
    }
  ],
