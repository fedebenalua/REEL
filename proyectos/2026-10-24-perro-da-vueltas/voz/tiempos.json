{
  "firma": "13762914592e",
  "duracion": 34,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro da vueltas antes de echarse?",
      "clave": "vueltas",
      "inicio": 0,
      "fin": 2.8
    },
    {
      "n": 2,
      "texto": "Dicen que mira alrededor, por si hay peligro.",
      "clave": "peligro",
      "inicio": 2.92,
      "fin": 5.68
    },
    {
      "n": 3,
      "texto": "Eso, que se sepa, no se ha medido.",
      "clave": "medido",
      "inicio": 5.76,
      "fin": 8.32
    },
    {
      "n": 4,
      "texto": "Lo que sí se probó fue el suelo.",
      "clave": "suelo",
      "inicio": 8.36,
      "fin": 10.4
    },
    {
      "n": 5,
      "texto": "Sesenta y dos perros, y dos alfombras.",
      "clave": "alfombras",
      "inicio": 10.44,
      "fin": 13.04
    },
    {
      "n": 6,
      "texto": "En la lisa, uno de cada cinco dio la vuelta.",
      "clave": "cinco",
      "inicio": 13.08,
      "fin": 15.76
    },
    {
      "n": 7,
      "texto": "En la de pelo largo, con bultos, más de la mitad.",
      "clave": "mitad",
      "inicio": 15.8,
      "fin": 18.88
    },
    {
      "n": 8,
      "texto": "Casi el triple. Y solo ahí alguno escarbaba.",
      "clave": "triple",
      "inicio": 18.92,
      "fin": 22.4
    },
    {
      "n": 9,
      "texto": "Aún así, no queda demostrado que sea la única razón.",
      "clave": "única",
      "inicio": 22.44,
      "fin": 25.68
    },
    {
      "n": 10,
      "texto": "En lo que sí hay datos, se está haciendo la cama.",
      "clave": "cama",
      "inicio": 25.76,
      "fin": 28.64
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo al que su perro da tres vueltas en el sofá y se le tumba encima.",
      "clave": "encima",
      "inicio": 28.72,
      "fin": 33.2
    }
  ],
