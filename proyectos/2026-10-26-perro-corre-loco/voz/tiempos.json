{
  "firma": "f8010f07a05c",
  "duracion": 30.24,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro se pone a correr como un loco, sin venir a cuento?",
      "clave": "loco",
      "inicio": 0,
      "fin": 3.92
    },
    {
      "n": 2,
      "texto": "No está loco: se lo está pasando bien.",
      "clave": "bien",
      "inicio": 4,
      "fin": 6.56
    },
    {
      "n": 3,
      "texto": "Y no hay una causa concreta.",
      "clave": "causa",
      "inicio": 6.6,
      "fin": 8.24
    },
    {
      "n": 4,
      "texto": "Parece que suelta de golpe lo que lleva guardado.",
      "clave": "suelta",
      "inicio": 8.293,
      "fin": 10.96
    },
    {
      "n": 5,
      "texto": "Sobre todo si ha pasado el día solo, sin nada que hacer.",
      "clave": "solo",
      "inicio": 11,
      "fin": 14
    },
    {
      "n": 6,
      "texto": "O cuando llegas y se emociona.",
      "clave": "llegas",
      "inicio": 14.04,
      "fin": 16
    },
    {
      "n": 7,
      "texto": "Pasa sobre todo de cachorro.",
      "clave": "cachorro",
      "inicio": 16.08,
      "fin": 17.6
    },
    {
      "n": 8,
      "texto": "Y a algunos, toda la vida.",
      "clave": "vida",
      "inicio": 17.68,
      "fin": 19.68
    },
    {
      "n": 9,
      "texto": "En el césped, se le deja.",
      "clave": "césped",
      "inicio": 19.72,
      "fin": 21.44
    },
    {
      "n": 10,
      "texto": "Si va tenso y con miedo, eso ya es otra cosa.",
      "clave": "miedo",
      "inicio": 21.52,
      "fin": 24.72
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo al que su perro da tres vueltas al sofá y se tumba como si nada.",
      "clave": "sofá",
      "inicio": 24.84,
      "fin": 29.44
    }
  ],
