{
  "firma": "675694258667",
  "duracion": 36.8,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote can turn the soundbar up, and you never pointed at it.",
      "clave": "pointed",
      "inicio": 0,
      "fin": 4.08
    },
    {
      "n": 2,
      "texto": "That light stops at the TV. The soundbar never sees it.",
      "clave": "stops",
      "inicio": 4.16,
      "fin": 8.08
    },
    {
      "n": 3,
      "texto": "The order walks down the HDMI cable, on one single wire.",
      "clave": "wire",
      "inicio": 8.16,
      "fin": 12.08
    },
    {
      "n": 4,
      "texto": "The TV says louder, and it shuts its own speakers.",
      "clave": "speakers",
      "inicio": 12.16,
      "fin": 15.6
    },
    {
      "n": 5,
      "texto": "One press can put every box on that wire to sleep.",
      "clave": "sleep",
      "inicio": 15.68,
      "fin": 18.88
    },
    {
      "n": 6,
      "texto": "Samsung calls that wire Anynet plus.",
      "clave": "plus",
      "inicio": 18.96,
      "fin": 21.52
    },
    {
      "n": 7,
      "texto": "Sony calls it Bravia Sync, and LG calls it SimpLink.",
      "clave": "SimpLink",
      "inicio": 21.6,
      "fin": 25.44
    },
    {
      "n": 8,
      "texto": "Same wire. So one remote can run the whole pile.",
      "clave": "one",
      "inicio": 25.56,
      "fin": 28.88
    },
    {
      "n": 9,
      "texto": "Now your phone can be that remote.",
      "clave": "phone",
      "inicio": 29,
      "fin": 31.12
    },
    {
      "n": 10,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 31.2,
      "fin": 32.96
    },
    {
      "n": 11,
      "texto": "Send it to that friend who still keeps three remotes on the couch.",
      "clave": "friend",
      "inicio": 33.04,
      "fin": 36
    }
  ],
