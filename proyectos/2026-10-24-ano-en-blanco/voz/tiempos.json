{
  "firma": "3a830d78d6b7",
  "duracion": 41.84,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué no te acuerdas de cuando eras un bebé?",
      "clave": "bebé",
      "inicio": 0,
      "fin": 2.08
    },
    {
      "n": 2,
      "texto": "Parece que de bebé no se guardaba nada.",
      "clave": "nada",
      "inicio": 2.64,
      "fin": 4.64
    },
    {
      "n": 3,
      "texto": "Con tres meses, si patea, bailan los muñecos de la cuna.",
      "clave": "patea",
      "inicio": 5.12,
      "fin": 8.32
    },
    {
      "n": 4,
      "texto": "Días después los ve quietos, y patea otra vez.",
      "clave": "quietos",
      "inicio": 8.8,
      "fin": 11.52
    },
    {
      "n": 5,
      "texto": "Con seis meses, un recuerdo así aguanta unas dos semanas.",
      "clave": "semanas",
      "inicio": 12.08,
      "fin": 15.52
    },
    {
      "n": 6,
      "texto": "Y aun así, de adulto, ese primer año no lo cuentas.",
      "clave": "cuentas",
      "inicio": 15.92,
      "fin": 19.04
    },
    {
      "n": 7,
      "texto": "En crías de ratón, neuronas nuevas deshacen las huellas viejas.",
      "clave": "huellas",
      "inicio": 19.68,
      "fin": 23.36
    },
    {
      "n": 8,
      "texto": "En personas, eso no está igual de claro.",
      "clave": "claro",
      "inicio": 23.6,
      "fin": 25.92
    },
    {
      "n": 9,
      "texto": "Puede que no tuviera palabras, y ahora lo busques hablando.",
      "clave": "palabras",
      "inicio": 26.56,
      "fin": 29.52
    },
    {
      "n": 10,
      "texto": "O que la historia que cuentas empiece hacia los tres o los cuatro años.",
      "clave": "años",
      "inicio": 30,
      "fin": 33.44
    },
    {
      "n": 11,
      "texto": "No es que no te pasara nada. Es que no se quedó como una historia.",
      "clave": "historia",
      "inicio": 34,
      "fin": 37.52
    },
    {
      "n": 12,
      "texto": "Envíaselo a ese amigo que dice que se acuerda de la cuna.",
      "clave": "cuna",
      "inicio": 38.24,
      "fin": 41.04
    }
  ],
