{
  "firma": "5c8cb7b3e217",
  "duracion": 38.88,
  "frases": [
    {
      "n": 1,
      "texto": "You can point your TV remote at the ceiling, and the channel still changes.",
      "clave": "ceiling",
      "inicio": 0,
      "fin": 4.16
    },
    {
      "n": 2,
      "texto": "You never aimed at the TV.",
      "clave": "aimed",
      "inicio": 4.24,
      "fin": 6.08
    },
    {
      "n": 3,
      "texto": "The light you can't see hits the white paint and bounces down.",
      "clave": "bounces",
      "inicio": 6.16,
      "fin": 9.6
    },
    {
      "n": 4,
      "texto": "It lands in the little eye on the set, and the channel jumps.",
      "clave": "eye",
      "inicio": 9.68,
      "fin": 13.12
    },
    {
      "n": 5,
      "texto": "Same trick as a flashlight in a dark room.",
      "clave": "flashlight",
      "inicio": 13.2,
      "fin": 15.52
    },
    {
      "n": 6,
      "texto": "The beam hits the ceiling, and the whole room fills.",
      "clave": "fills",
      "inicio": 15.6,
      "fin": 18.8
    },
    {
      "n": 7,
      "texto": "The first wireless remote was a flashlight too.",
      "clave": "first",
      "inicio": 18.88,
      "fin": 21.52
    },
    {
      "n": 8,
      "texto": "It only worked if you hit one corner of the screen.",
      "clave": "corner",
      "inicio": 21.56,
      "fin": 24.32
    },
    {
      "n": 9,
      "texto": "Miss that corner, and nothing happened.",
      "clave": "nothing",
      "inicio": 24.44,
      "fin": 26.72
    },
    {
      "n": 10,
      "texto": "Now one bounce is enough.",
      "clave": "bounce",
      "inicio": 26.8,
      "fin": 28.64
    },
    {
      "n": 11,
      "texto": "Your phone skips the ceiling.",
      "clave": "phone",
      "inicio": 28.72,
      "fin": 30.48
    },
    {
      "n": 12,
      "texto": "The app talks to the TV over your wifi.",
      "clave": "wifi",
      "inicio": 30.52,
      "fin": 33.04
    },
    {
      "n": 13,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 33.12,
      "fin": 35.04
    },
    {
      "n": 14,
      "texto": "Send it to that friend who still lines the remote up like a dart.",
      "clave": "dart",
      "inicio": 35.12,
      "fin": 38.08
    }
  ],
