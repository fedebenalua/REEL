{
  "firma": "535f51cdcf01",
  "duracion": 59.52,
  "frases": [
    {
      "n": 1,
      "texto": "Te abren la cabeza, te tocan el cerebro, y tú sigues hablando.",
      "clave": "cerebro",
      "inicio": 0,
      "fin": 4.32
    },
    {
      "n": 2,
      "texto": "Despierto, en una operación de verdad, y no gritas.",
      "clave": "gritas",
      "inicio": 4.64,
      "fin": 7.96
    },
    {
      "n": 3,
      "texto": "En el dedo, un corte te hace saltar.",
      "clave": "saltar",
      "inicio": 8.24,
      "fin": 10.4
    },
    {
      "n": 4,
      "texto": "La piel va llena de alarmas, y cada una avisa.",
      "clave": "alarmas",
      "inicio": 10.88,
      "fin": 13.92
    },
    {
      "n": 5,
      "texto": "En el quirófano te despiertan a mitad, a propósito.",
      "clave": "despiertan",
      "inicio": 14.64,
      "fin": 17.72
    },
    {
      "n": 6,
      "texto": "Te ponen dibujos: dices manzana, dices llave, y mueves la mano.",
      "clave": "manzana",
      "inicio": 18,
      "fin": 22.56
    },
    {
      "n": 7,
      "texto": "Así ven qué parte del cerebro no pueden quitar.",
      "clave": "quitar",
      "inicio": 22.64,
      "fin": 25.84
    },
    {
      "n": 8,
      "texto": "Si una chispa cae donde hablas, la palabra se queda a medias.",
      "clave": "medias",
      "inicio": 25.88,
      "fin": 29.6
    },
    {
      "n": 9,
      "texto": "Solo mientras dura la chispa. Luego vuelve, y ahí no cortan.",
      "clave": "vuelve",
      "inicio": 29.72,
      "fin": 33.68
    },
    {
      "n": 10,
      "texto": "Tú sigues tranquilo, hablando, sin un quejido.",
      "clave": "tranquilo",
      "inicio": 33.707,
      "fin": 37.2
    },
    {
      "n": 11,
      "texto": "El mismo toque, en el brazo, te haría retirar la mano.",
      "clave": "brazo",
      "inicio": 37.28,
      "fin": 40.72
    },
    {
      "n": 12,
      "texto": "El tejido del cerebro no tiene alarmas de dolor.",
      "clave": "tejido",
      "inicio": 40.76,
      "fin": 43.68
    },
    {
      "n": 13,
      "texto": "La piel y la funda sí: eso se duerme.",
      "clave": "funda",
      "inicio": 43.72,
      "fin": 47.28
    },
    {
      "n": 14,
      "texto": "Por dentro, el corte no avisa.",
      "clave": "corte",
      "inicio": 47.32,
      "fin": 49.52
    },
    {
      "n": 15,
      "texto": "Un vasito estirado escuece un segundo, y no es el cerebro.",
      "clave": "vasito",
      "inicio": 49.6,
      "fin": 53.44
    },
    {
      "n": 16,
      "texto": "El dolor de cabeza sale de la funda.",
      "clave": "cabeza",
      "inicio": 53.48,
      "fin": 55.84
    },
    {
      "n": 17,
      "texto": "Envíaselo a ese amigo que cree que le duele el cerebro.",
      "clave": "amigo",
      "inicio": 55.96,
      "fin": 58.72
    }
  ],
