{
  "firma": "1c7b093eedea",
  "duracion": 40.8,
  "frases": [
    {
      "n": 1,
      "texto": "Si te quedas sin pilas o siempre pierdes el mando de la tele, tengo la solución.",
      "clave": "solución",
      "inicio": 0,
      "fin": 4.88
    },
    {
      "n": 2,
      "texto": "Pero primero, mira cómo funciona tu mando.",
      "clave": "funciona",
      "inicio": 4.933,
      "fin": 7.6
    },
    {
      "n": 3,
      "texto": "Al pulsar un botón, la goma baja y toca dos caminos de cobre: se cierra el circuito.",
      "clave": "circuito",
      "inicio": 7.68,
      "fin": 12.96
    },
    {
      "n": 4,
      "texto": "Un chip convierte ese botón en un número, distinto para cada botón.",
      "clave": "número",
      "inicio": 13,
      "fin": 17.12
    },
    {
      "n": 5,
      "texto": "Y la lucecita de la punta lo manda parpadeando, en un morse de luz que tus ojos no ven.",
      "clave": "morse",
      "inicio": 17.16,
      "fin": 22.08
    },
    {
      "n": 6,
      "texto": "En la tele, un ojito la recibe, lee el número y hace lo que dice: sube el volumen.",
      "clave": "volumen",
      "inicio": 22.12,
      "fin": 27.44
    },
    {
      "n": 7,
      "texto": "Pero sin pilas, la lucecita no se enciende, y el mando ya no sirve para nada.",
      "clave": "pilas",
      "inicio": 27.52,
      "fin": 32.48
    },
    {
      "n": 8,
      "texto": "La solución: tu móvil también puede hablar con la tele.",
      "clave": "móvil",
      "inicio": 32.56,
      "fin": 36
    },
    {
      "n": 9,
      "texto": "Descarga la app que tienes en el link de la bio, y tu móvil será tu mando.",
      "clave": "app",
      "inicio": 36.12,
      "fin": 40
    }
  ],
