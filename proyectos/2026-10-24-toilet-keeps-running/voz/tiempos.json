{
  "firma": "60bd0c04fb67",
  "duracion": 41.84,
  "frases": [
    {
      "n": 1,
      "texto": "Why does your toilet keep running?",
      "clave": "running",
      "inicio": 0,
      "fin": 2
    },
    {
      "n": 2,
      "texto": "A leaky one wastes about two hundred gallons a day.",
      "clave": "gallons",
      "inicio": 2.08,
      "fin": 5.44
    },
    {
      "n": 3,
      "texto": "If water spills down the overflow tube, the float is too high.",
      "clave": "spills",
      "inicio": 5.52,
      "fin": 9.36
    },
    {
      "n": 4,
      "texto": "Turn the screw beside the float counterclockwise, until the water stops an inch below the top.",
      "clave": "counterclockwise",
      "inicio": 9.48,
      "fin": 14.64
    },
    {
      "n": 5,
      "texto": "If it doesn't spill, the flapper isn't sealing. Shut the wall valve clockwise, and flush once.",
      "clave": "flapper",
      "inicio": 14.72,
      "fin": 20.64
    },
    {
      "n": 6,
      "texto": "Lift off the old flapper, and clip on a new one the same size.",
      "clave": "new",
      "inicio": 20.72,
      "fin": 24.32
    },
    {
      "n": 7,
      "texto": "Leave half an inch of slack in the chain, then open the valve.",
      "clave": "slack",
      "inicio": 24.44,
      "fin": 27.84
    },
    {
      "n": 8,
      "texto": "The water rises and stops, and the hiss goes quiet.",
      "clave": "quiet",
      "inicio": 27.92,
      "fin": 31.44
    },
    {
      "n": 9,
      "texto": "Keep bleach tablets out of the tank. They warp that rubber.",
      "clave": "bleach",
      "inicio": 31.56,
      "fin": 34.96
    },
    {
      "n": 10,
      "texto": "If the wall valve won't turn, stop and call a plumber.",
      "clave": "plumber",
      "inicio": 35.04,
      "fin": 38.4
    },
    {
      "n": 11,
      "texto": "Send this to that friend whose toilet won't stop running.",
      "clave": "friend",
      "inicio": 38.48,
      "fin": 41.04
    }
  ],
