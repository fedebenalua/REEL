{
  "firma": "38910352286b",
  "duracion": 37.44,
  "frases": [
    {
      "n": 1,
      "texto": "This remote could copy every other remote in the house.",
      "clave": "copy",
      "inicio": 0,
      "fin": 3.08
    },
    {
      "n": 2,
      "texto": "It came from the man who designed the Apple II.",
      "clave": "Apple",
      "inicio": 3.28,
      "fin": 5.68
    },
    {
      "n": 3,
      "texto": "And almost nobody bought it.",
      "clave": "nobody",
      "inicio": 5.76,
      "fin": 7.68
    },
    {
      "n": 4,
      "texto": "You held your old one up to it, and it watched flashes your eyes can't see.",
      "clave": "flashes",
      "inicio": 7.76,
      "fin": 12
    },
    {
      "n": 5,
      "texto": "One button could turn the TV on, start the tape, and find the channel.",
      "clave": "button",
      "inicio": 12.08,
      "fin": 15.84
    },
    {
      "n": 6,
      "texto": "It could even do that while you were out.",
      "clave": "out",
      "inicio": 15.88,
      "fin": 17.76
    },
    {
      "n": 7,
      "texto": "But you had to program it, and it was as long as a pencil.",
      "clave": "pencil",
      "inicio": 17.84,
      "fin": 21.28
    },
    {
      "n": 8,
      "texto": "Cheaper remotes, from companies people already knew, sold instead.",
      "clave": "Cheaper",
      "inicio": 21.36,
      "fin": 25.28
    },
    {
      "n": 9,
      "texto": "The next year, he put the company up for sale.",
      "clave": "sale",
      "inicio": 25.36,
      "fin": 28.16
    },
    {
      "n": 10,
      "texto": "The idea didn't die. It moved into your phone.",
      "clave": "phone",
      "inicio": 28.2,
      "fin": 31.12
    },
    {
      "n": 11,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 31.2,
      "fin": 33.12
    },
    {
      "n": 12,
      "texto": "Send it to that friend who still keeps a pile of remotes on the table.",
      "clave": "friend",
      "inicio": 33.2,
      "fin": 36.64
    }
  ],
