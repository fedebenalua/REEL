{
  "firma": "20867b87d78d",
  "duracion": 42.8,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que el mando de la tele ganó un Emmy, como si fuera una serie?",
      "clave": "Emmy",
      "inicio": 0,
      "fin": 3.88
    },
    {
      "n": 2,
      "texto": "Antes, para cambiar de canal tenías que levantarte, ir hasta la tele y girar una rueda.",
      "clave": "rueda",
      "inicio": 4.16,
      "fin": 9.52
    },
    {
      "n": 3,
      "texto": "En 1950 salió el primer mando, pero iba atado a la tele con un cable que cruzaba el salón.",
      "clave": "cable",
      "inicio": 9.56,
      "fin": 15.52
    },
    {
      "n": 4,
      "texto": "Y la gente tropezaba con él.",
      "clave": "tropezaba",
      "inicio": 15.547,
      "fin": 17.36
    },
    {
      "n": 5,
      "texto": "Así que le quitaron el cable, y en 1997 sus inventores se llevaron un Emmy.",
      "clave": "inventores",
      "inicio": 17.44,
      "fin": 23.04
    },
    {
      "n": 6,
      "texto": "Hoy es tan normal que solo te acuerdas de él cuando desaparece.",
      "clave": "desaparece",
      "inicio": 23.08,
      "fin": 26.72
    },
    {
      "n": 7,
      "texto": "Por eso el último invento es que el mando sea tu móvil.",
      "clave": "móvil",
      "inicio": 26.76,
      "fin": 30.16
    },
    {
      "n": 8,
      "texto": "Con una app, el móvil le habla a la tele por el wifi de casa: enciendes, subes el volumen, cambias de canal.",
      "clave": "wifi",
      "inicio": 30.24,
      "fin": 36.32
    },
    {
      "n": 9,
      "texto": "Yo uso una que te dejo en el link de la bio.",
      "clave": "bio",
      "inicio": 36.8,
      "fin": 39.2
    },
    {
      "n": 10,
      "texto": "Y envíaselo a ese amigo que siempre esconde el mando.",
      "clave": "esconde",
      "inicio": 39.227,
      "fin": 42
    }
  ],
