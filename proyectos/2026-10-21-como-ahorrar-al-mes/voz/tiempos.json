{
  "firma": "941a49f86af0",
  "duracion": 46.08,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que el café de cada mañana te puede costar casi quinientos euros al año?",
      "clave": "quinientos",
      "inicio": 0,
      "fin": 4.76
    },
    {
      "n": 2,
      "texto": "Son los gastos que no ves. Cuatro trucos para que no se te escape el dinero cada mes.",
      "clave": "cuatro",
      "inicio": 5.04,
      "fin": 10.4
    },
    {
      "n": 3,
      "texto": "Uno: cuenta tus gastos hormiga. Un café de un euro ochenta cada día de trabajo son unos cuarenta euros al mes.",
      "clave": "hormiga",
      "inicio": 10.52,
      "fin": 17.68
    },
    {
      "n": 4,
      "texto": "Dos: revisa tus suscripciones. Tres de diez euros que ya no usas son trescientos sesenta euros al año.",
      "clave": "suscripciones",
      "inicio": 17.76,
      "fin": 24.56
    },
    {
      "n": 5,
      "texto": "Tres: págate a ti primero. El día que cobras, pasa cincuenta euros a otra cuenta antes de gastar nada.",
      "clave": "primero",
      "inicio": 24.667,
      "fin": 31.12
    },
    {
      "n": 6,
      "texto": "Cuatro: antes de un capricho, espera un día entero. Muchas veces, al día siguiente ya no lo quieres.",
      "clave": "día",
      "inicio": 31.16,
      "fin": 37.36
    },
    {
      "n": 7,
      "texto": "Solo con los tres primeros, son más de mil cuatrocientos euros al año.",
      "clave": "mil",
      "inicio": 37.48,
      "fin": 41.36
    },
    {
      "n": 8,
      "texto": "Envíaselo a ese amigo que siempre llega a fin de mes con la cuenta a cero.",
      "clave": "cero",
      "inicio": 41.44,
      "fin": 45.28
    }
  ],
