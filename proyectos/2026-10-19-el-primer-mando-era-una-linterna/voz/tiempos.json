{
  "firma": "3127817c40a0",
  "duracion": 43.04,
  "frases": [
    {
      "n": 1,
      "texto": "El primer mando de la tele era una linterna, y el sol te cambiaba de canal.",
      "clave": "sol",
      "inicio": 0,
      "fin": 4.52
    },
    {
      "n": 2,
      "texto": "Apuntabas a una esquina de la pantalla, y cada esquina hacía una cosa.",
      "clave": "esquina",
      "inicio": 4.8,
      "fin": 8.88
    },
    {
      "n": 3,
      "texto": "Pero si entraba el sol por la ventana, la tele se volvía loca.",
      "clave": "loca",
      "inicio": 8.933,
      "fin": 12.64
    },
    {
      "n": 4,
      "texto": "Así que al año siguiente sacaron otro, sin luz y sin pilas.",
      "clave": "pilas",
      "inicio": 12.72,
      "fin": 16.52
    },
    {
      "n": 5,
      "texto": "Cada botón golpeaba una barrita de metal con un martillo diminuto.",
      "clave": "martillo",
      "inicio": 16.8,
      "fin": 20.72
    },
    {
      "n": 6,
      "texto": "Sonaba tan agudo que tú no lo oías, pero la tele sí.",
      "clave": "agudo",
      "inicio": 20.8,
      "fin": 24.24
    },
    {
      "n": 7,
      "texto": "Y no le pusieron pilas por miedo a que, al gastarse, pensaras que la tele estaba rota.",
      "clave": "rota",
      "inicio": 24.28,
      "fin": 29.44
    },
    {
      "n": 8,
      "texto": "Hoy tu mando usa una luz que no ves, y sigue gastando pilas.",
      "clave": "pilas",
      "inicio": 29.493,
      "fin": 33.44
    },
    {
      "n": 9,
      "texto": "El siguiente mando ya lo llevas en el bolsillo: tu móvil.",
      "clave": "móvil",
      "inicio": 33.52,
      "fin": 36.96
    },
    {
      "n": 10,
      "texto": "Descarga la app que tienes en el link de la bio, y envíaselo a ese amigo que siempre está sin pilas.",
      "clave": "app",
      "inicio": 37.04,
      "fin": 42.24
    }
  ],
