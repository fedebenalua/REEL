{
  "firma": "adcce490105f",
  "duracion": 54.88,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro se pone de norte a sur para hacer caca?",
      "clave": "norte",
      "inicio": 0,
      "fin": 3.52
    },
    {
      "n": 2,
      "texto": "Setenta perros lo anotaron durante dos años.",
      "clave": "setenta",
      "inicio": 3.64,
      "fin": 6.28
    },
    {
      "n": 3,
      "texto": "Casi dos mil veces, y la media no señalaba ningún sitio.",
      "clave": "media",
      "inicio": 6.48,
      "fin": 10.56
    },
    {
      "n": 4,
      "texto": "Ordenaron los paseos después, según el campo de ese día.",
      "clave": "después",
      "inicio": 10.72,
      "fin": 13.88
    },
    {
      "n": 5,
      "texto": "Con la brújula quieta, el lomo se quedaba de norte a sur.",
      "clave": "lomo",
      "inicio": 14.16,
      "fin": 17.68
    },
    {
      "n": 6,
      "texto": "Cuarenta y tres perros, con el eje casi clavado.",
      "clave": "clavado",
      "inicio": 17.72,
      "fin": 20.8
    },
    {
      "n": 7,
      "texto": "Si el norte se movía más de un dos por ciento, el eje desaparecía.",
      "clave": "ciento",
      "inicio": 20.88,
      "fin": 24.48
    },
    {
      "n": 8,
      "texto": "Y el campo solo está tan quieto una de cada cinco horas de sol.",
      "clave": "cinco",
      "inicio": 25.04,
      "fin": 28.4
    },
    {
      "n": 9,
      "texto": "Creen que así calibra el mapa, y solo si el norte no tiembla.",
      "clave": "mapa",
      "inicio": 28.88,
      "fin": 32.32
    },
    {
      "n": 10,
      "texto": "En cinco parques de ciudad, otro estudio no lo encontró.",
      "clave": "ciudad",
      "inicio": 33.12,
      "fin": 36
    },
    {
      "n": 11,
      "texto": "Cincuenta y dos perros: en el pis mandaba la valla, no el norte.",
      "clave": "valla",
      "inicio": 36.4,
      "fin": 40.16
    },
    {
      "n": 12,
      "texto": "En la caca, ni la valla ni el norte.",
      "clave": "caca",
      "inicio": 40.56,
      "fin": 42.72
    },
    {
      "n": 13,
      "texto": "Así que parece, en campo abierto y con la brújula quieta.",
      "clave": "parece",
      "inicio": 43.12,
      "fin": 46.08
    },
    {
      "n": 14,
      "texto": "No todos los estudios lo confirman.",
      "clave": "confirman",
      "inicio": 46.64,
      "fin": 48.56
    },
    {
      "n": 15,
      "texto": "Envíaselo a ese amigo al que su perro da tres vueltas en la acera y se agacha mirando al semáforo.",
      "clave": "semáforo",
      "inicio": 49.04,
      "fin": 54.08
    }
  ],
