{
  "firma": "b4af1b04c267",
  "duracion": 41.2,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que el primer móvil pesaba más de un kilo?",
      "clave": "kilo",
      "inicio": 0,
      "fin": 3.2
    },
    {
      "n": 2,
      "texto": "Medía veinticinco centímetros, y por eso lo llamaban el ladrillo.",
      "clave": "ladrillo",
      "inicio": 3.28,
      "fin": 7.52
    },
    {
      "n": 3,
      "texto": "Tardaba diez horas en cargarse, para solo media hora de llamada.",
      "clave": "diez",
      "inicio": 7.6,
      "fin": 11.44
    },
    {
      "n": 4,
      "texto": "Y costaba casi cuatro mil dólares: siete meses de sueldo mínimo en Estados Unidos.",
      "clave": "dólares",
      "inicio": 11.48,
      "fin": 16.88
    },
    {
      "n": 5,
      "texto": "Hoy ese ladrillo cabe en el bolsillo del pantalón.",
      "clave": "bolsillo",
      "inicio": 16.92,
      "fin": 19.76
    },
    {
      "n": 6,
      "texto": "Y en vez de una cosa, hace cuatro: cámara, linterna, despertador y mapa.",
      "clave": "cuatro",
      "inicio": 19.787,
      "fin": 25.04
    },
    {
      "n": 7,
      "texto": "Y ahora también hace de mando de la tele.",
      "clave": "mando",
      "inicio": 25.08,
      "fin": 27.36
    },
    {
      "n": 8,
      "texto": "Con una app, tu móvil tiene el volumen, los canales y las flechas.",
      "clave": "app",
      "inicio": 27.4,
      "fin": 31.28
    },
    {
      "n": 9,
      "texto": "Y ya no tienes que buscar el mando entre los cojines.",
      "clave": "cojines",
      "inicio": 31.32,
      "fin": 34
    },
    {
      "n": 10,
      "texto": "Si quieres probarlo, el link de la app está en la bio.",
      "clave": "bio",
      "inicio": 34.04,
      "fin": 36.88
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo que aún guarda su primer móvil en un cajón.",
      "clave": "cajón",
      "inicio": 37,
      "fin": 40.4
    }
  ],
