{
  "firma": "df43a4310ac8",
  "duracion": 56.24,
  "frases": [
    {
      "n": 1,
      "texto": "Dos cosas a la vez, y una siempre espera.",
      "clave": "espera",
      "inicio": 0,
      "fin": 2.8
    },
    {
      "n": 2,
      "texto": "Te hablan y escribes. Las dos, ahora mismo.",
      "clave": "escribes",
      "inicio": 3.28,
      "fin": 6.4
    },
    {
      "n": 3,
      "texto": "Todo el mundo dice que sí puede.",
      "clave": "puede",
      "inicio": 6.88,
      "fin": 8.88
    },
    {
      "n": 4,
      "texto": "Si fueran juntas de verdad, la segunda no se quedaría atrás.",
      "clave": "atrás",
      "inicio": 8.92,
      "fin": 12.72
    },
    {
      "n": 5,
      "texto": "Encienden dos señales muy pegadas. Respondes a las dos.",
      "clave": "señales",
      "inicio": 13.2,
      "fin": 16.72
    },
    {
      "n": 6,
      "texto": "La primera mano llega. La segunda se queda en el aire.",
      "clave": "aire",
      "inicio": 17.12,
      "fin": 20.32
    },
    {
      "n": 7,
      "texto": "Si las acercas, la segunda tarda casi lo que las has acercado.",
      "clave": "acercado",
      "inicio": 20.96,
      "fin": 24.32
    },
    {
      "n": 8,
      "texto": "Sola, esa mano es igual de rápida.",
      "clave": "rápida",
      "inicio": 24.8,
      "fin": 27.04
    },
    {
      "n": 9,
      "texto": "En la cocina pasa igual: el mensaje y la sartén. Una se queda.",
      "clave": "sartén",
      "inicio": 27.92,
      "fin": 32.16
    },
    {
      "n": 10,
      "texto": "La sartén sigue quieta hasta que el mensaje termina.",
      "clave": "quieta",
      "inicio": 32.56,
      "fin": 35.12
    },
    {
      "n": 11,
      "texto": "No van juntas: eliges una cada vez.",
      "clave": "eliges",
      "inicio": 35.76,
      "fin": 38.24
    },
    {
      "n": 12,
      "texto": "Al cambiar de regla se te va, de media, casi un segundo.",
      "clave": "segundo",
      "inicio": 38.8,
      "fin": 41.84
    },
    {
      "n": 13,
      "texto": "Caminar y hablar se estorban menos, aunque el paso se frena.",
      "clave": "paso",
      "inicio": 42.48,
      "fin": 45.6
    },
    {
      "n": 14,
      "texto": "Si el camino se complica, se te corta la frase.",
      "clave": "corta",
      "inicio": 46.08,
      "fin": 48.56
    },
    {
      "n": 15,
      "texto": "Era una, y luego la otra.",
      "clave": "luego",
      "inicio": 49.04,
      "fin": 50.88
    },
    {
      "n": 16,
      "texto": "Envíaselo a ese amigo que dice que él sí hace varias cosas a la vez.",
      "clave": "varias",
      "inicio": 51.6,
      "fin": 55.44
    }
  ],
