{
  "firma": "8c5e62af3177",
  "duracion": 44.48,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que el café no te quita el sueño, solo lo esconde?",
      "clave": "esconde",
      "inicio": 0,
      "fin": 3.68
    },
    {
      "n": 2,
      "texto": "Y por eso, a veces, te arruina la noche sin que lo notes.",
      "clave": "noche",
      "inicio": 3.76,
      "fin": 7.16
    },
    {
      "n": 3,
      "texto": "Mientras estás despierto, tu cerebro va acumulando adenosina.",
      "clave": "adenosina",
      "inicio": 7.52,
      "fin": 11.12
    },
    {
      "n": 4,
      "texto": "Cuanta más hay, más sueño tienes.",
      "clave": "sueño",
      "inicio": 11.16,
      "fin": 13.52
    },
    {
      "n": 5,
      "texto": "Pues el café no la quita: tapa los huecos donde encaja, y tú no notas nada.",
      "clave": "tapa",
      "inicio": 13.56,
      "fin": 18.56
    },
    {
      "n": 6,
      "texto": "Pero la adenosina sigue subiendo, esperando a que se vaya la cafeína.",
      "clave": "subiendo",
      "inicio": 18.613,
      "fin": 22.56
    },
    {
      "n": 7,
      "texto": "Y se va despacio: tarda entre tres y cinco horas en perder la mitad.",
      "clave": "mitad",
      "inicio": 22.6,
      "fin": 27.12
    },
    {
      "n": 8,
      "texto": "No te da energía: solo te tapa el cansancio.",
      "clave": "energía",
      "inicio": 27.2,
      "fin": 30.4
    },
    {
      "n": 9,
      "texto": "Un estudio vio que una dosis alta seis horas antes de acostarte te quita más de una hora de sueño, y ni lo notas.",
      "clave": "hora",
      "inicio": 30.44,
      "fin": 37.36
    },
    {
      "n": 10,
      "texto": "Así que el último café, seis horas antes de dormir.",
      "clave": "seis",
      "inicio": 37.44,
      "fin": 40.8
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo que se toma un café después de cenar.",
      "clave": "Envíaselo",
      "inicio": 40.88,
      "fin": 43.68
    }
  ],
