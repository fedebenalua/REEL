{
  "firma": "980baf46b943",
  "duracion": 44.72,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote was invented to shut the ads up.",
      "clave": "ads",
      "inicio": 0,
      "fin": 3.4
    },
    {
      "n": 2,
      "texto": "The man who ran Zenith hated commercials so much, he thought television would die.",
      "clave": "die",
      "inicio": 3.68,
      "fin": 8.56
    },
    {
      "n": 3,
      "texto": "He wanted a button that could mute them from the couch.",
      "clave": "mute",
      "inicio": 8.64,
      "fin": 11.52
    },
    {
      "n": 4,
      "texto": "The first one was a cable across the floor, and people tripped on it.",
      "clave": "tripped",
      "inicio": 11.6,
      "fin": 15.2
    },
    {
      "n": 5,
      "texto": "It changed the channel. The ad kept talking.",
      "clave": "talking",
      "inicio": 15.28,
      "fin": 18.347
    },
    {
      "n": 6,
      "texto": "So the next one was a flashlight. Aim it at the corner, and the sound dies.",
      "clave": "flashlight",
      "inicio": 18.453,
      "fin": 22.96
    },
    {
      "n": 7,
      "texto": "Sunshine hit the screen, and the channels spun on their own.",
      "clave": "spun",
      "inicio": 23.04,
      "fin": 26.32
    },
    {
      "n": 8,
      "texto": "It did not kill the ads. It taught you to leave them.",
      "clave": "leave",
      "inicio": 26.36,
      "fin": 29.68
    },
    {
      "n": 9,
      "texto": "Before the remote, you were stuck, because getting up was too much.",
      "clave": "stuck",
      "inicio": 29.84,
      "fin": 33.52
    },
    {
      "n": 10,
      "texto": "One click, and you were gone, so the ads learned to grab you.",
      "clave": "grab",
      "inicio": 33.6,
      "fin": 37.36
    },
    {
      "n": 11,
      "texto": "That button is in your phone now. The app is in the link in my bio.",
      "clave": "phone",
      "inicio": 37.44,
      "fin": 41.28
    },
    {
      "n": 12,
      "texto": "Send this to that friend who still yells at the ads.",
      "clave": "yells",
      "inicio": 41.36,
      "fin": 43.92
    }
  ],
