{
  "firma": "30b942628e4b",
  "duracion": 41.6,
  "frases": [
    {
      "n": 1,
      "texto": "Toilet clogged, and there's no plunger?",
      "clave": "plunger",
      "inicio": 0,
      "fin": 2.16
    },
    {
      "n": 2,
      "texto": "Don't flush it again. You'll send the water over the rim.",
      "clave": "flush",
      "inicio": 2.56,
      "fin": 5.64
    },
    {
      "n": 3,
      "texto": "A wad of paper is stuck in the bend under the bowl.",
      "clave": "bend",
      "inicio": 5.92,
      "fin": 8.72
    },
    {
      "n": 4,
      "texto": "Turn the valve on the wall clockwise, all the way shut.",
      "clave": "clockwise",
      "inicio": 8.96,
      "fin": 12.16
    },
    {
      "n": 5,
      "texto": "If the water sits at the rim, scoop some into a bucket.",
      "clave": "bucket",
      "inicio": 12.24,
      "fin": 15.36
    },
    {
      "n": 6,
      "texto": "Pour in about half a cup of dish soap, and wait fifteen minutes.",
      "clave": "soap",
      "inicio": 15.44,
      "fin": 18.96
    },
    {
      "n": 7,
      "texto": "Then pour about a gallon of hot tap water from waist height, and stand back.",
      "clave": "gallon",
      "inicio": 19.12,
      "fin": 23.52
    },
    {
      "n": 8,
      "texto": "Never boiling. That can crack the bowl.",
      "clave": "boiling",
      "inicio": 23.6,
      "fin": 26
    },
    {
      "n": 9,
      "texto": "Flush once, and the water spirals down.",
      "clave": "spirals",
      "inicio": 26.08,
      "fin": 28.72
    },
    {
      "n": 10,
      "texto": "Still stuck, or the tub gurgles too? Stop, and call a plumber.",
      "clave": "plumber",
      "inicio": 28.84,
      "fin": 33.2
    },
    {
      "n": 11,
      "texto": "And skip the chemical clog remover. The label says not for toilets.",
      "clave": "label",
      "inicio": 33.24,
      "fin": 37.36
    },
    {
      "n": 12,
      "texto": "Send this to that friend whose toilet is clogged, with no plunger.",
      "clave": "friend",
      "inicio": 37.44,
      "fin": 40.8
    }
  ],
