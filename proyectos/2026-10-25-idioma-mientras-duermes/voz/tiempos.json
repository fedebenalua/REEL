{
  "firma": "26117bf910dc",
  "duracion": 55.2,
  "frases": [
    {
      "n": 1,
      "texto": "¿Poner un idioma mientras duermes te lo enseña?",
      "clave": "enseña",
      "inicio": 0,
      "fin": 2.56
    },
    {
      "n": 2,
      "texto": "La grabación suena toda la noche, palabra tras palabra.",
      "clave": "grabación",
      "inicio": 2.88,
      "fin": 6.4
    },
    {
      "n": 3,
      "texto": "Y al abrir los ojos, se supone que ya lo hablas.",
      "clave": "hablas",
      "inicio": 6.64,
      "fin": 9.32
    },
    {
      "n": 4,
      "texto": "Por la tarde dejas una secuencia en los dedos.",
      "clave": "dedos",
      "inicio": 9.6,
      "fin": 11.96
    },
    {
      "n": 5,
      "texto": "Cuatro teclas, siempre en el mismo orden.",
      "clave": "teclas",
      "inicio": 12.16,
      "fin": 14.72
    },
    {
      "n": 6,
      "texto": "Luego te duermes.",
      "clave": "duermes",
      "inicio": 14.96,
      "fin": 16.08
    },
    {
      "n": 7,
      "texto": "A la mañana, esos dedos van más rápidos.",
      "clave": "rápidos",
      "inicio": 16.32,
      "fin": 18.72
    },
    {
      "n": 8,
      "texto": "Alrededor de un veinte por ciento.",
      "clave": "veinte",
      "inicio": 19.04,
      "fin": 20.72
    },
    {
      "n": 9,
      "texto": "Y sin fallar más que antes.",
      "clave": "fallar",
      "inicio": 21.04,
      "fin": 22.8
    },
    {
      "n": 10,
      "texto": "Si te quedas despierto esas horas, casi no cambia.",
      "clave": "cambia",
      "inicio": 23.04,
      "fin": 25.52
    },
    {
      "n": 11,
      "texto": "La noche no crea la secuencia.",
      "clave": "crea",
      "inicio": 25.84,
      "fin": 27.8
    },
    {
      "n": 12,
      "texto": "Deja más firme la que ya habías hecho.",
      "clave": "firme",
      "inicio": 28,
      "fin": 29.92
    },
    {
      "n": 13,
      "texto": "La hiciste despierto, con los ojos abiertos.",
      "clave": "abiertos",
      "inicio": 30.32,
      "fin": 32.72
    },
    {
      "n": 14,
      "texto": "Dormir no añade teclas: afianza esas.",
      "clave": "afianza",
      "inicio": 33.2,
      "fin": 36
    },
    {
      "n": 15,
      "texto": "Un idioma que no has estudiado no se queda.",
      "clave": "queda",
      "inicio": 36.4,
      "fin": 38.68
    },
    {
      "n": 16,
      "texto": "No amaneces hablándolo.",
      "clave": "amaneces",
      "inicio": 38.88,
      "fin": 40.28
    },
    {
      "n": 17,
      "texto": "En el sueño profundo, a veces, una palabra inclina una elección.",
      "clave": "elección",
      "inicio": 40.48,
      "fin": 44.72
    },
    {
      "n": 18,
      "texto": "Ni te acuerdas, y no es un idioma.",
      "clave": "idioma",
      "inicio": 44.76,
      "fin": 47.04
    },
    {
      "n": 19,
      "texto": "La noche sella lo que ya metiste. No te lo cuela por el oído.",
      "clave": "sella",
      "inicio": 47.12,
      "fin": 50.96
    },
    {
      "n": 20,
      "texto": "Si quieres ver tu cociente, está en la app del enlace de la bio.",
      "clave": "cociente",
      "inicio": 51.04,
      "fin": 54.4
    }
  ],
