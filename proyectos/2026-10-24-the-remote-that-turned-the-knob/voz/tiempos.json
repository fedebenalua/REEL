{
  "firma": "3d9e5f5355a3",
  "duracion": 32.4,
  "frases": [
    {
      "n": 1,
      "texto": "The first TV remote turned the channel knob from the sofa.",
      "clave": "knob",
      "inicio": 0,
      "fin": 3.84
    },
    {
      "n": 2,
      "texto": "A motor inside the TV cranked it through a wire.",
      "clave": "motor",
      "inicio": 3.92,
      "fin": 7.12
    },
    {
      "n": 3,
      "texto": "One button turned it up. The other turned it back.",
      "clave": "back",
      "inicio": 7.2,
      "fin": 10.32
    },
    {
      "n": 4,
      "texto": "It could turn the set off, too.",
      "clave": "off",
      "inicio": 10.36,
      "fin": 12.32
    },
    {
      "n": 5,
      "texto": "That wire ran across the rug, and people tripped over it.",
      "clave": "tripped",
      "inicio": 12.4,
      "fin": 15.92
    },
    {
      "n": 6,
      "texto": "Now the button turns nothing.",
      "clave": "nothing",
      "inicio": 16,
      "fin": 18.053
    },
    {
      "n": 7,
      "texto": "It blinks a light your eyes can't see.",
      "clave": "light",
      "inicio": 18.107,
      "fin": 20.373
    },
    {
      "n": 8,
      "texto": "The TV reads that light and jumps to the channel.",
      "clave": "jumps",
      "inicio": 20.427,
      "fin": 23.16
    },
    {
      "n": 9,
      "texto": "No knob has to turn.",
      "clave": "knob",
      "inicio": 23.2,
      "fin": 24.933
    },
    {
      "n": 10,
      "texto": "Your phone can jump the channel too.",
      "clave": "phone",
      "inicio": 24.987,
      "fin": 26.773
    },
    {
      "n": 11,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 26.827,
      "fin": 28.6
    },
    {
      "n": 12,
      "texto": "Send it to that friend who still gets up to change the channel.",
      "clave": "friend",
      "inicio": 28.64,
      "fin": 31.6
    }
  ],
