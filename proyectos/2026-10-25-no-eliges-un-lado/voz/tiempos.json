{
  "firma": "f047786eb771",
  "duracion": 44.24,
  "frases": [
    {
      "n": 1,
      "texto": "¿Y si tu cerebro no tuviera lado lógico ni lado creativo?",
      "clave": "creativo",
      "inicio": 0,
      "fin": 3.92
    },
    {
      "n": 2,
      "texto": "Te lo pintan así: el izquierdo calcula y el derecho inventa.",
      "clave": "calcula",
      "inicio": 3.96,
      "fin": 7.8
    },
    {
      "n": 3,
      "texto": "Y dicen que tú vives en uno de los dos.",
      "clave": "vives",
      "inicio": 8,
      "fin": 10
    },
    {
      "n": 4,
      "texto": "Si escribes con la derecha, algo sí se apoya en un lado.",
      "clave": "derecha",
      "inicio": 10.48,
      "fin": 13.64
    },
    {
      "n": 5,
      "texto": "Las palabras tiran más a la izquierda.",
      "clave": "palabras",
      "inicio": 13.84,
      "fin": 16
    },
    {
      "n": 6,
      "texto": "Atender a lo que tienes delante, más a la derecha.",
      "clave": "delante",
      "inicio": 16.08,
      "fin": 18.68
    },
    {
      "n": 7,
      "texto": "Por eso parece que cada persona elige una mitad.",
      "clave": "mitad",
      "inicio": 18.88,
      "fin": 21.52
    },
    {
      "n": 8,
      "texto": "En dos mil trece miraron mil once cerebros, en reposo.",
      "clave": "once",
      "inicio": 22,
      "fin": 25.68
    },
    {
      "n": 9,
      "texto": "De siete a veintinueve años, sin calcular y sin inventar.",
      "clave": "reposo",
      "inicio": 25.76,
      "fin": 29.52
    },
    {
      "n": 10,
      "texto": "Un enlace fuerte solo arrastra a los que toca.",
      "clave": "toca",
      "inicio": 29.76,
      "fin": 32.48
    },
    {
      "n": 11,
      "texto": "No se lleva el cerebro entero hacia un lado.",
      "clave": "entero",
      "inicio": 32.52,
      "fin": 34.72
    },
    {
      "n": 12,
      "texto": "No sales de cerebro izquierdo ni de cerebro derecho.",
      "clave": "sales",
      "inicio": 34.8,
      "fin": 37.68
    },
    {
      "n": 13,
      "texto": "Los dos lados hacen su parte a la vez.",
      "clave": "parte",
      "inicio": 37.76,
      "fin": 40.32
    },
    {
      "n": 14,
      "texto": "Envíaselo a ese amigo que dice que es de cerebro derecho.",
      "clave": "amigo",
      "inicio": 40.44,
      "fin": 43.44
    }
  ],
