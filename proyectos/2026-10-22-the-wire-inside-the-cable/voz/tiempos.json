{
  "firma": "4558be24dc5f",
  "duracion": 42.64,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote turns the soundbar up, and it never points at it.",
      "clave": "soundbar",
      "inicio": 0,
      "fin": 4.16
    },
    {
      "n": 2,
      "texto": "That little light hits the TV, and it stops.",
      "clave": "stops",
      "inicio": 4.24,
      "fin": 7.04
    },
    {
      "n": 3,
      "texto": "So who tells the bar?",
      "clave": "who",
      "inicio": 7.12,
      "fin": 8.88
    },
    {
      "n": 4,
      "texto": "The order runs down one wire, inside the cable.",
      "clave": "wire",
      "inicio": 8.96,
      "fin": 12.16
    },
    {
      "n": 5,
      "texto": "You press volume. The TV whispers. The bar gets loud.",
      "clave": "loud",
      "inicio": 12.24,
      "fin": 16.56
    },
    {
      "n": 6,
      "texto": "Swap that cable for an optical one, and the same press does nothing.",
      "clave": "nothing",
      "inicio": 16.64,
      "fin": 20.48
    },
    {
      "n": 7,
      "texto": "That one carries sound as a red light. It has no wire for orders.",
      "clave": "orders",
      "inicio": 20.56,
      "fin": 24.8
    },
    {
      "n": 8,
      "texto": "The first remote was a wire across the floor, and people tripped on it.",
      "clave": "tripped",
      "inicio": 24.88,
      "fin": 28.48
    },
    {
      "n": 9,
      "texto": "So they cut the wire. Then only the TV could hear you.",
      "clave": "cut",
      "inicio": 28.56,
      "fin": 32.213
    },
    {
      "n": 10,
      "texto": "The wire came back, hidden inside the picture cable.",
      "clave": "back",
      "inicio": 32.267,
      "fin": 35.28
    },
    {
      "n": 11,
      "texto": "Now your phone is the remote.",
      "clave": "phone",
      "inicio": 35.44,
      "fin": 37.253
    },
    {
      "n": 12,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 37.307,
      "fin": 39.16
    },
    {
      "n": 13,
      "texto": "Send it to that friend who still aims at the soundbar.",
      "clave": "friend",
      "inicio": 39.2,
      "fin": 41.84
    }
  ],
