{
  "firma": "5b93f25e4c5e",
  "duracion": 40,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro come hierba?",
      "clave": "hierba",
      "inicio": 0,
      "fin": 2.08
    },
    {
      "n": 2,
      "texto": "Casi todo el mundo cree que está malo y que quiere vomitar.",
      "clave": "vomitar",
      "inicio": 2.16,
      "fin": 5.44
    },
    {
      "n": 3,
      "texto": "Miraron perros sanos con hierba a mano: casi ocho de cada diez la comían.",
      "clave": "ocho",
      "inicio": 5.52,
      "fin": 10.4
    },
    {
      "n": 4,
      "texto": "Y de los que la comen, casi ocho de cada diez casi nunca vomitan.",
      "clave": "nunca",
      "inicio": 10.44,
      "fin": 14.56
    },
    {
      "n": 5,
      "texto": "Cuanto más jóvenes, más la comen, y menos vomitan.",
      "clave": "jóvenes",
      "inicio": 14.6,
      "fin": 17.92
    },
    {
      "n": 6,
      "texto": "Ni el pienso ni la comida de casa cambiaban las veces que la comía.",
      "clave": "pienso",
      "inicio": 17.96,
      "fin": 21.6
    },
    {
      "n": 7,
      "texto": "Los lobos también comen hierba: les viene de antes de vivir en casa.",
      "clave": "lobos",
      "inicio": 21.68,
      "fin": 25.52
    },
    {
      "n": 8,
      "texto": "Menos de uno de cada diez parece malo antes, y esos vomitan más.",
      "clave": "diez",
      "inicio": 25.6,
      "fin": 29.84
    },
    {
      "n": 9,
      "texto": "Así que no se está purgando: es normal, y para qué, aún no se sabe.",
      "clave": "normal",
      "inicio": 29.92,
      "fin": 34.88
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que, en cuanto prueba la hierba, ya llama al veterinario.",
      "clave": "veterinario",
      "inicio": 35,
      "fin": 39.2
    }
  ],
