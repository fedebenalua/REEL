{
  "firma": "c7a6a2021afa",
  "duracion": 34.24,
  "frases": [
    {
      "n": 1,
      "texto": "How do you fix a hole in the wall?",
      "clave": "hole",
      "inicio": 0,
      "fin": 2.08
    },
    {
      "n": 2,
      "texto": "That doorknob punched the drywall, and the filler falls straight through.",
      "clave": "through",
      "inicio": 2.2,
      "fin": 5.92
    },
    {
      "n": 3,
      "texto": "Peel a metal patch and press it on, past the torn edge.",
      "clave": "patch",
      "inicio": 5.96,
      "fin": 9.333
    },
    {
      "n": 4,
      "texto": "Spread three thin coats of joint compound, and let each one dry.",
      "clave": "coats",
      "inicio": 9.467,
      "fin": 13.12
    },
    {
      "n": 5,
      "texto": "A thick blob shrinks into a hump. The last coat goes on wide.",
      "clave": "wide",
      "inicio": 13.2,
      "fin": 17.28
    },
    {
      "n": 6,
      "texto": "Sand it lightly, prime it, and paint the same color.",
      "clave": "prime",
      "inicio": 17.4,
      "fin": 20.32
    },
    {
      "n": 7,
      "texto": "Skip the primer, and the patch shows through the paint.",
      "clave": "shows",
      "inicio": 20.44,
      "fin": 23.013
    },
    {
      "n": 8,
      "texto": "A doorstop on the baseboard keeps the knob off the wall.",
      "clave": "doorstop",
      "inicio": 23.067,
      "fin": 26.12
    },
    {
      "n": 9,
      "texto": "Bigger than six inches, or a wire in the hole? Don't saw. Call a pro.",
      "clave": "pro",
      "inicio": 26.16,
      "fin": 30.88
    },
    {
      "n": 10,
      "texto": "Send this to that friend whose doorknob went through the wall.",
      "clave": "friend",
      "inicio": 30.96,
      "fin": 33.44
    }
  ],
