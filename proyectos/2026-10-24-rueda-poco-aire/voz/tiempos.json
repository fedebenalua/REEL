{
  "firma": "b0a79ac63e09",
  "duracion": 50.56,
  "frases": [
    {
      "n": 1,
      "texto": "¿Cómo sabe un coche que una rueda tiene poco aire?",
      "clave": "aire",
      "inicio": 0,
      "fin": 3.12
    },
    {
      "n": 2,
      "texto": "No la mira. Dentro de la rueda no hay ojos.",
      "clave": "ojos",
      "inicio": 3.28,
      "fin": 6.2
    },
    {
      "n": 3,
      "texto": "En unos, un sensor pegado a la válvula mide el aire y lo manda por radio.",
      "clave": "sensor",
      "inicio": 6.48,
      "fin": 10.96
    },
    {
      "n": 4,
      "texto": "Cuando falta alrededor de una quinta parte, el testigo se enciende.",
      "clave": "quinta",
      "inicio": 11,
      "fin": 14.72
    },
    {
      "n": 5,
      "texto": "En otros no hay sensor dentro: cuentan las vueltas de cada rueda.",
      "clave": "vueltas",
      "inicio": 15.04,
      "fin": 19.12
    },
    {
      "n": 6,
      "texto": "Con menos aire, la rueda es más pequeña y gira más deprisa para no quedarse atrás.",
      "clave": "deprisa",
      "inicio": 19.2,
      "fin": 24.08
    },
    {
      "n": 7,
      "texto": "Como una moneda al lado de un plato: la pequeña da más vueltas en el mismo camino.",
      "clave": "moneda",
      "inicio": 24.16,
      "fin": 29.04
    },
    {
      "n": 8,
      "texto": "Si una gira más deprisa que las otras, esa es la baja.",
      "clave": "baja",
      "inicio": 29.08,
      "fin": 32.72
    },
    {
      "n": 9,
      "texto": "Si bajan las cuatro igual, todas giran igual y no se nota cuál.",
      "clave": "igual",
      "inicio": 32.76,
      "fin": 36.72
    },
    {
      "n": 10,
      "texto": "Pero cada rueda, al girar, vibra. Con menos aire, esa vibración va más lenta.",
      "clave": "lenta",
      "inicio": 36.76,
      "fin": 42.32
    },
    {
      "n": 11,
      "texto": "Así que no adivina: o mide el aire por radio, o cuenta las vueltas.",
      "clave": "adivina",
      "inicio": 42.4,
      "fin": 46.88
    },
    {
      "n": 12,
      "texto": "Envíaselo a ese amigo que pasa del testigo de la rueda.",
      "clave": "testigo",
      "inicio": 46.96,
      "fin": 49.76
    }
  ],
