{
  "firma": "22abcc6ff90d",
  "duracion": 30.4,
  "frases": [
    {
      "n": 1,
      "texto": "¿Cómo sabe tu móvil que tienes la pantalla pegada a la oreja?",
      "clave": "oreja",
      "inicio": 0,
      "fin": 2.96
    },
    {
      "n": 2,
      "texto": "La acercas a la mejilla y, en ese instante, se apaga.",
      "clave": "apaga",
      "inicio": 3.44,
      "fin": 6.32
    },
    {
      "n": 3,
      "texto": "Pero no te reconoce la oreja.",
      "clave": "reconoce",
      "inicio": 6.8,
      "fin": 8.4
    },
    {
      "n": 4,
      "texto": "Lo habitual es una luz que tú no ves, como la del mando.",
      "clave": "mando",
      "inicio": 8.88,
      "fin": 11.76
    },
    {
      "n": 5,
      "texto": "Sale, rebota en lo que tengas delante y vuelve.",
      "clave": "rebota",
      "inicio": 12.24,
      "fin": 14.88
    },
    {
      "n": 6,
      "texto": "Si vuelve mucha, hay algo muy cerca.",
      "clave": "cerca",
      "inicio": 15.36,
      "fin": 17.52
    },
    {
      "n": 7,
      "texto": "Entonces apaga la pantalla y deja de hacer caso a los toques.",
      "clave": "toques",
      "inicio": 17.92,
      "fin": 21.12
    },
    {
      "n": 8,
      "texto": "Así que no sabe que es tu oreja. Solo sabe que hay algo pegado al cristal.",
      "clave": "cristal",
      "inicio": 21.6,
      "fin": 26.48
    },
    {
      "n": 9,
      "texto": "Envíaselo a ese amigo que cuelga sin querer con la mejilla.",
      "clave": "mejilla",
      "inicio": 26.6,
      "fin": 29.6
    }
  ],
