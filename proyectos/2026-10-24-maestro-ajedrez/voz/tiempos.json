{
  "firma": "70cc25b34aa2",
  "duracion": 41.76,
  "frases": [
    {
      "n": 1,
      "texto": "Un maestro de ajedrez, en cinco segundos, devuelve unas dieciséis piezas a su sitio.",
      "clave": "dieciséis",
      "inicio": 0,
      "fin": 5.12
    },
    {
      "n": 2,
      "texto": "Un principiante, en esos mismos cinco, devuelve unas cuatro.",
      "clave": "cuatro",
      "inicio": 5.16,
      "fin": 8.96
    },
    {
      "n": 3,
      "texto": "¿Tiene más memoria que tú?",
      "clave": "memoria",
      "inicio": 8.987,
      "fin": 10.32
    },
    {
      "n": 4,
      "texto": "La partida es de verdad: unas veinticinco piezas, a mitad de juego, y se la tapan enseguida.",
      "clave": "tapan",
      "inicio": 10.64,
      "fin": 15.52
    },
    {
      "n": 5,
      "texto": "Cualquiera diría que se ha hecho una foto.",
      "clave": "foto",
      "inicio": 16,
      "fin": 18.08
    },
    {
      "n": 6,
      "texto": "Pero una foto no sabe de ajedrez: le daría igual.",
      "clave": "igual",
      "inicio": 18.133,
      "fin": 20.96
    },
    {
      "n": 7,
      "texto": "Así que pon las mismas piezas al azar.",
      "clave": "azar",
      "inicio": 21.36,
      "fin": 23.6
    },
    {
      "n": 8,
      "texto": "Ahí se le cae casi todo: no guardaba casillas, guardaba grupos de una partida de verdad.",
      "clave": "grupos",
      "inicio": 23.84,
      "fin": 28.88
    },
    {
      "n": 9,
      "texto": "Y cada grupo le cabe en un solo hueco.",
      "clave": "hueco",
      "inicio": 29.28,
      "fin": 31.44
    },
    {
      "n": 10,
      "texto": "No tiene más memoria. Tiene más partidas dentro.",
      "clave": "partidas",
      "inicio": 31.84,
      "fin": 34.72
    },
    {
      "n": 11,
      "texto": "Si quieres ver tu cociente, está en la aplicación del enlace de la bio. Es un número, no lo que vales.",
      "clave": "número",
      "inicio": 35.28,
      "fin": 40.96
    }
  ],
