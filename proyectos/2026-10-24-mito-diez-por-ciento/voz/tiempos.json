{
  "firma": "977e0637110c",
  "duracion": 55.92,
  "frases": [
    {
      "n": 1,
      "texto": "Dicen que el noventa por ciento de tu cerebro está apagado.",
      "clave": "apagado",
      "inicio": 0,
      "fin": 3.52
    },
    {
      "n": 2,
      "texto": "Si fuera verdad, podrían quitártelo y seguirías hablando y andando.",
      "clave": "andando",
      "inicio": 3.56,
      "fin": 7.12
    },
    {
      "n": 3,
      "texto": "Como si de tu casa solo sirviera el recibidor, y el resto estuviera vacío.",
      "clave": "recibidor",
      "inicio": 7.76,
      "fin": 12.32
    },
    {
      "n": 4,
      "texto": "Pero mira la zona del habla.",
      "clave": "habla",
      "inicio": 12.373,
      "fin": 13.6
    },
    {
      "n": 5,
      "texto": "Se estropea esa sola, y las palabras dejan de salir.",
      "clave": "palabras",
      "inicio": 14,
      "fin": 16.96
    },
    {
      "n": 6,
      "texto": "Justo detrás está la del brazo.",
      "clave": "detrás",
      "inicio": 17.6,
      "fin": 19.28
    },
    {
      "n": 7,
      "texto": "Se estropea, y el brazo deja de obedecerte.",
      "clave": "obedecerte",
      "inicio": 19.68,
      "fin": 22.32
    },
    {
      "n": 8,
      "texto": "Y sale carísimo: un kilo cuatrocientos, el dos por ciento del cuerpo.",
      "clave": "cuatrocientos",
      "inicio": 22.8,
      "fin": 27.28
    },
    {
      "n": 9,
      "texto": "Se bebe una de cada cinco calorías que quemas sin moverte.",
      "clave": "cinco",
      "inicio": 27.92,
      "fin": 30.88
    },
    {
      "n": 10,
      "texto": "Incluso dormido, el gasto baja solo un poco.",
      "clave": "dormido",
      "inicio": 31.28,
      "fin": 33.76
    },
    {
      "n": 11,
      "texto": "Nadie paga esa factura por tenerlo apagado.",
      "clave": "factura",
      "inicio": 34.32,
      "fin": 36.72
    },
    {
      "n": 12,
      "texto": "En reposo no hay un noventa por ciento a oscuras: hay redes por todas partes.",
      "clave": "reposo",
      "inicio": 37.2,
      "fin": 41.84
    },
    {
      "n": 13,
      "texto": "No entero a la vez: eso sería una crisis.",
      "clave": "crisis",
      "inicio": 42.32,
      "fin": 45.2
    },
    {
      "n": 14,
      "texto": "Nunca se midió ese diez por ciento. Era talento, y acabó en mito.",
      "clave": "mito",
      "inicio": 45.28,
      "fin": 49.84
    },
    {
      "n": 15,
      "texto": "Así que no te sobra cerebro.",
      "clave": "sobra",
      "inicio": 49.92,
      "fin": 51.92
    },
    {
      "n": 16,
      "texto": "Envíaselo a ese amigo que todavía cree que le sobra cabeza.",
      "clave": "amigo",
      "inicio": 52.04,
      "fin": 55.12
    }
  ],
