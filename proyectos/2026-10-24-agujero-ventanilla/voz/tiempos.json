{
  "firma": "24d7153421eb",
  "duracion": 48.88,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué los aviones tienen un pequeño agujero en las ventanillas?",
      "clave": "agujero",
      "inicio": 0,
      "fin": 3.6
    },
    {
      "n": 2,
      "texto": "Parece un defecto. No lo es.",
      "clave": "defecto",
      "inicio": 3.68,
      "fin": 6
    },
    {
      "n": 3,
      "texto": "Son tres láminas de plástico, una detrás de otra.",
      "clave": "láminas",
      "inicio": 6.12,
      "fin": 9.28
    },
    {
      "n": 4,
      "texto": "La de dentro es como el protector del móvil: la tocas tú, para no rayar la de verdad.",
      "clave": "protector",
      "inicio": 9.36,
      "fin": 14.4
    },
    {
      "n": 5,
      "texto": "El agujero está en la del medio, abajo.",
      "clave": "medio",
      "inicio": 14.48,
      "fin": 17.12
    },
    {
      "n": 6,
      "texto": "En vuelo, dentro empuja mucho más que fuera.",
      "clave": "empuja",
      "inicio": 17.2,
      "fin": 20.24
    },
    {
      "n": 7,
      "texto": "El aire pasa por ese agujero y empuja solo la lámina de fuera.",
      "clave": "fuera",
      "inicio": 20.32,
      "fin": 24.16
    },
    {
      "n": 8,
      "texto": "La del medio descansa: es la de reserva.",
      "clave": "reserva",
      "inicio": 24.2,
      "fin": 27.04
    },
    {
      "n": 9,
      "texto": "Si la de fuera se rompe, la del medio aguanta ella sola.",
      "clave": "rompe",
      "inicio": 27.08,
      "fin": 30.48
    },
    {
      "n": 10,
      "texto": "Se escapa un hilo de aire, tan poco que la cabina lo repone.",
      "clave": "hilo",
      "inicio": 30.52,
      "fin": 34.08
    },
    {
      "n": 11,
      "texto": "Y saca el vaho, como el espejo del baño si le dejas una rendija.",
      "clave": "vaho",
      "inicio": 34.12,
      "fin": 37.84
    },
    {
      "n": 12,
      "texto": "Por eso el hielo, cuando sale, se queda en un anillo en el agujero.",
      "clave": "anillo",
      "inicio": 37.88,
      "fin": 41.52
    },
    {
      "n": 13,
      "texto": "Así que no está roto: está ahí para que veas el cielo.",
      "clave": "cielo",
      "inicio": 41.6,
      "fin": 45.28
    },
    {
      "n": 14,
      "texto": "Envíaselo a ese amigo que siempre pide ventanilla.",
      "clave": "ventanilla",
      "inicio": 45.4,
      "fin": 48.08
    }
  ],
