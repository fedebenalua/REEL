{
  "firma": "5b481e180c4a",
  "duracion": 35.36,
  "frases": [
    {
      "n": 1,
      "texto": "How do you fix a squeaky door in thirty seconds?",
      "clave": "squeaky",
      "inicio": 0,
      "fin": 3.12
    },
    {
      "n": 2,
      "texto": "That squeak is a dry pin, grinding metal on metal inside the hinge.",
      "clave": "pin",
      "inicio": 3.24,
      "fin": 7.68
    },
    {
      "n": 3,
      "texto": "Close the door, and pull just one pin. All of them, and the door drops.",
      "clave": "one",
      "inicio": 7.8,
      "fin": 12.4
    },
    {
      "n": 4,
      "texto": "Tap it up from underneath with a nail. If it sticks, lift the handle and slide it out.",
      "clave": "nail",
      "inicio": 12.48,
      "fin": 17.48
    },
    {
      "n": 5,
      "texto": "Wipe the grit off, and coat the pin with petroleum jelly.",
      "clave": "jelly",
      "inicio": 17.52,
      "fin": 20.773
    },
    {
      "n": 6,
      "texto": "Push it back down, wipe the extra, and swing the door.",
      "clave": "swing",
      "inicio": 20.827,
      "fin": 24.04
    },
    {
      "n": 7,
      "texto": "Skip the cooking oil. It runs, and then it turns sticky.",
      "clave": "sticky",
      "inicio": 24.08,
      "fin": 27.6
    },
    {
      "n": 8,
      "texto": "Still noisy? Tighten the screws. A warped frame needs a carpenter.",
      "clave": "carpenter",
      "inicio": 27.68,
      "fin": 31.88
    },
    {
      "n": 9,
      "texto": "Send this to that friend whose door squeaks every morning.",
      "clave": "morning",
      "inicio": 31.92,
      "fin": 34.56
    }
  ],
