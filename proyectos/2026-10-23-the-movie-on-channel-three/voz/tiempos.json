{
  "firma": "c28524a80ec8",
  "duracion": 36.64,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote used to play the movie on a channel that wasn't real.",
      "clave": "real",
      "inicio": 0,
      "fin": 4.08
    },
    {
      "n": 2,
      "texto": "The tape never went into the TV.",
      "clave": "tape",
      "inicio": 4.16,
      "fin": 6.32
    },
    {
      "n": 3,
      "texto": "The TV only had a hole for the antenna.",
      "clave": "antenna",
      "inicio": 6.4,
      "fin": 8.88
    },
    {
      "n": 4,
      "texto": "So the VCR turned the movie into its own tiny station.",
      "clave": "station",
      "inicio": 9.04,
      "fin": 12.92
    },
    {
      "n": 5,
      "texto": "You set that station to channel three, or to channel four.",
      "clave": "three",
      "inicio": 12.96,
      "fin": 16.187
    },
    {
      "n": 6,
      "texto": "Whichever one your city wasn't already using.",
      "clave": "city",
      "inicio": 16.213,
      "fin": 18.72
    },
    {
      "n": 7,
      "texto": "One button on the remote chose the antenna, or that fake station.",
      "clave": "button",
      "inicio": 18.8,
      "fin": 22.52
    },
    {
      "n": 8,
      "texto": "The movie was never a channel. The button just let the little station through.",
      "clave": "through",
      "inicio": 22.56,
      "fin": 27.04
    },
    {
      "n": 9,
      "texto": "Today the picture rides its own cable.",
      "clave": "cable",
      "inicio": 27.2,
      "fin": 29.4
    },
    {
      "n": 10,
      "texto": "The source button just picks which one.",
      "clave": "source",
      "inicio": 29.44,
      "fin": 31.48
    },
    {
      "n": 11,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 31.52,
      "fin": 33.24
    },
    {
      "n": 12,
      "texto": "Send it to that friend who still hunts for channel three.",
      "clave": "friend",
      "inicio": 33.28,
      "fin": 35.84
    }
  ],
