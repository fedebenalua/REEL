{
  "firma": "fc7e3a661825",
  "duracion": 42.4,
  "frases": [
    {
      "n": 1,
      "texto": "Your keys could change the TV channel.",
      "clave": "keys",
      "inicio": 0,
      "fin": 2.4
    },
    {
      "n": 2,
      "texto": "Right from the coffee table.",
      "clave": "table",
      "inicio": 2.52,
      "fin": 3.92
    },
    {
      "n": 3,
      "texto": "The remote never moved.",
      "clave": "moved",
      "inicio": 4,
      "fin": 5.68
    },
    {
      "n": 4,
      "texto": "The TV was listening for a note you can't hear.",
      "clave": "note",
      "inicio": 5.76,
      "fin": 8.72
    },
    {
      "n": 5,
      "texto": "A little hammer hit a metal rod.",
      "clave": "hammer",
      "inicio": 8.76,
      "fin": 10.8
    },
    {
      "n": 6,
      "texto": "The rod rang about forty thousand times a second.",
      "clave": "thousand",
      "inicio": 10.88,
      "fin": 14.08
    },
    {
      "n": 7,
      "texto": "Four rods, four notes.",
      "clave": "notes",
      "inicio": 14.16,
      "fin": 15.92
    },
    {
      "n": 8,
      "texto": "Channel up, channel down, the sound, and the power.",
      "clave": "power",
      "inicio": 16.08,
      "fin": 19.68
    },
    {
      "n": 9,
      "texto": "A jangle of keys could fool the TV.",
      "clave": "jangle",
      "inicio": 19.72,
      "fin": 21.76
    },
    {
      "n": 10,
      "texto": "So could a glass, when you clink it.",
      "clave": "clink",
      "inicio": 22.16,
      "fin": 24.16
    },
    {
      "n": 11,
      "texto": "Then the TV stopped listening.",
      "clave": "stopped",
      "inicio": 24.24,
      "fin": 26.24
    },
    {
      "n": 12,
      "texto": "Now the button blinks a light your eyes can't see.",
      "clave": "light",
      "inicio": 26.36,
      "fin": 29.2
    },
    {
      "n": 13,
      "texto": "Keys can jangle.",
      "clave": "jangle",
      "inicio": 29.36,
      "fin": 30.4
    },
    {
      "n": 14,
      "texto": "The TV ignores them.",
      "clave": "ignores",
      "inicio": 30.44,
      "fin": 31.84
    },
    {
      "n": 15,
      "texto": "Your phone never makes that note.",
      "clave": "phone",
      "inicio": 31.92,
      "fin": 33.92
    },
    {
      "n": 16,
      "texto": "The app talks to the TV over your wifi.",
      "clave": "wifi",
      "inicio": 33.96,
      "fin": 36.64
    },
    {
      "n": 17,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 36.68,
      "fin": 38.64
    },
    {
      "n": 18,
      "texto": "Send it to that friend whose keys still live on the table.",
      "clave": "friend",
      "inicio": 38.72,
      "fin": 41.6
    }
  ],
