{
  "firma": "81e3e71aea49",
  "duracion": 41.28,
  "frases": [
    {
      "n": 1,
      "texto": "¿Cómo sabe tu lavadora cuánta ropa has metido?",
      "clave": "ropa",
      "inicio": 0,
      "fin": 2.72
    },
    {
      "n": 2,
      "texto": "No hay una báscula debajo: no la pesa.",
      "clave": "báscula",
      "inicio": 2.8,
      "fin": 5.16
    },
    {
      "n": 3,
      "texto": "En muchas, gira el tambor unos treinta segundos en seco, antes de echar el agua.",
      "clave": "treinta",
      "inicio": 5.44,
      "fin": 10.16
    },
    {
      "n": 4,
      "texto": "La ropa, quieta en el fondo, sube hacia un lado.",
      "clave": "lado",
      "inicio": 10.24,
      "fin": 13.28
    },
    {
      "n": 5,
      "texto": "El motor mide la corriente que hace falta para subirla: más ropa, más corriente.",
      "clave": "corriente",
      "inicio": 13.32,
      "fin": 18.08
    },
    {
      "n": 6,
      "texto": "Es como el cesto de la colada: vacío casi no pesa; lleno, te tira del brazo.",
      "clave": "cesto",
      "inicio": 18.16,
      "fin": 23.36
    },
    {
      "n": 7,
      "texto": "Con esa medida echa el agua que toca, y si hay mucha ropa alarga el lavado.",
      "clave": "alarga",
      "inicio": 23.44,
      "fin": 27.92
    },
    {
      "n": 8,
      "texto": "Y otro sensor, en el tubo, cuenta el agua que entra y cierra al llegar.",
      "clave": "sensor",
      "inicio": 27.96,
      "fin": 32.16
    },
    {
      "n": 9,
      "texto": "Así que no pesa la colada: siente lo que le cuesta levantarla.",
      "clave": "levantarla",
      "inicio": 32.24,
      "fin": 36.48
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que mete dos camisetas y pone carga completa.",
      "clave": "camisetas",
      "inicio": 36.56,
      "fin": 40.48
    }
  ],
