{
  "firma": "bd26fcadb6eb",
  "duracion": 47.44,
  "frases": [
    {
      "n": 1,
      "texto": "How do you unclog a sink full of water, without chemicals?",
      "clave": "chemicals",
      "inicio": 0,
      "fin": 3.76
    },
    {
      "n": 2,
      "texto": "Drain cleaner usually just burns a little hole, and the clog stays.",
      "clave": "hole",
      "inicio": 3.84,
      "fin": 7.76
    },
    {
      "n": 3,
      "texto": "That wad of hair and soap is stuck in the curved pipe under the sink.",
      "clave": "curved",
      "inicio": 7.88,
      "fin": 11.92
    },
    {
      "n": 4,
      "texto": "If you already poured cleaner in, stop. Don't open this pipe. Call a plumber.",
      "clave": "stop",
      "inicio": 12,
      "fin": 16.96
    },
    {
      "n": 5,
      "texto": "If you haven't, gloves on. A few inches of water, a wet cloth on the overflow, and plunge.",
      "clave": "plunge",
      "inicio": 17.04,
      "fin": 23.04
    },
    {
      "n": 6,
      "texto": "Still full? Set a bucket under the bend, and turn both nuts to the left.",
      "clave": "bucket",
      "inicio": 23.16,
      "fin": 27.68
    },
    {
      "n": 7,
      "texto": "Pull the pipe off. The water and the hair drop into the bucket.",
      "clave": "hair",
      "inicio": 27.76,
      "fin": 31.52
    },
    {
      "n": 8,
      "texto": "Seat the washers, twist the nuts on by hand, and snug them only if it drips.",
      "clave": "hand",
      "inicio": 31.6,
      "fin": 36.4
    },
    {
      "n": 9,
      "texto": "A strainer over the drain catches the next wad of hair.",
      "clave": "strainer",
      "inicio": 36.48,
      "fin": 39.6
    },
    {
      "n": 10,
      "texto": "If every sink in the house is slow, that's the main line. Call a plumber.",
      "clave": "slow",
      "inicio": 39.72,
      "fin": 44.24
    },
    {
      "n": 11,
      "texto": "Send this to that friend whose sink won't drain.",
      "clave": "friend",
      "inicio": 44.36,
      "fin": 46.64
    }
  ],
