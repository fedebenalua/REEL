{
  "firma": "9ed61ae63d19",
  "duracion": 40.48,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote still works when you point it at the ceiling.",
      "clave": "ceiling",
      "inicio": 0,
      "fin": 3.44
    },
    {
      "n": 2,
      "texto": "The light misses the TV, bounces off the paint, and the channel changes.",
      "clave": "bounces",
      "inicio": 3.48,
      "fin": 7.52
    },
    {
      "n": 3,
      "texto": "It isn't a laser. It spreads, like a flashlight.",
      "clave": "flashlight",
      "inicio": 7.76,
      "fin": 10.96
    },
    {
      "n": 4,
      "texto": "Back up twice as far, and that splash gets four times fainter.",
      "clave": "fainter",
      "inicio": 11.04,
      "fin": 14.8
    },
    {
      "n": 5,
      "texto": "Shove it under a cushion, and the light never gets out.",
      "clave": "cushion",
      "inicio": 14.84,
      "fin": 17.76
    },
    {
      "n": 6,
      "texto": "That's why a remote lost in the couch does nothing.",
      "clave": "nothing",
      "inicio": 17.84,
      "fin": 20.72
    },
    {
      "n": 7,
      "texto": "The first wireless remote had to hit one corner of the screen.",
      "clave": "corner",
      "inicio": 20.8,
      "fin": 24.16
    },
    {
      "n": 8,
      "texto": "That corner was the button. Miss it, and the set just sat there.",
      "clave": "sat",
      "inicio": 24.24,
      "fin": 28.4
    },
    {
      "n": 9,
      "texto": "Today the blinks are the button, so a bounce still counts.",
      "clave": "blinks",
      "inicio": 28.64,
      "fin": 32.4
    },
    {
      "n": 10,
      "texto": "Your phone can change the channel without pointing.",
      "clave": "phone",
      "inicio": 32.52,
      "fin": 35.04
    },
    {
      "n": 11,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 35.08,
      "fin": 37.04
    },
    {
      "n": 12,
      "texto": "Send it to that friend who aims the remote at the ceiling.",
      "clave": "friend",
      "inicio": 37.12,
      "fin": 39.68
    }
  ],
