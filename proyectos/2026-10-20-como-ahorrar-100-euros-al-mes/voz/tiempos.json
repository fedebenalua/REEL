{
  "firma": "ffc40bff5abb",
  "duracion": 45.92,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que cada mes se te escapan hasta cien euros por cinco agujeros que ni ves?",
      "clave": "agujeros",
      "inicio": 0,
      "fin": 4.72
    },
    {
      "n": 2,
      "texto": "¿Dónde están?",
      "clave": "dónde",
      "inicio": 4.96,
      "fin": 5.88
    },
    {
      "n": 3,
      "texto": "El primero, tu fibra y tu móvil: cambia de tarifa y ahorras hasta veintinueve euros al mes.",
      "clave": "fibra",
      "inicio": 6.16,
      "fin": 11.84
    },
    {
      "n": 4,
      "texto": "El segundo, las suscripciones: cancela dos de diez euros que ni abres y son veinte al mes.",
      "clave": "suscripciones",
      "inicio": 11.88,
      "fin": 17.68
    },
    {
      "n": 5,
      "texto": "El tercero, la comida que tiras: planifica la compra y ahorras unos veintiún euros al mes por persona.",
      "clave": "comida",
      "inicio": 17.72,
      "fin": 23.84
    },
    {
      "n": 6,
      "texto": "El cuarto, tu banco: algunos cobran hasta veinte euros al mes por la cuenta, y hay cuentas gratis.",
      "clave": "banco",
      "inicio": 23.88,
      "fin": 29.64
    },
    {
      "n": 7,
      "texto": "El quinto, tu luz: uno de cada tres hogares paga por más potencia de la que usa, unos siete euros al mes.",
      "clave": "luz",
      "inicio": 29.84,
      "fin": 36.16
    },
    {
      "n": 8,
      "texto": "Súmalos: casi cien euros al mes que ahora se te escapan.",
      "clave": "cien",
      "inicio": 36.2,
      "fin": 39.68
    },
    {
      "n": 9,
      "texto": "No es ganar más: es dejar de perder.",
      "clave": "perder",
      "inicio": 39.76,
      "fin": 42.24
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que nunca llega a fin de mes.",
      "clave": "Envíaselo",
      "inicio": 42.32,
      "fin": 45.12
    }
  ],
