{
  "firma": "1bd69afc8db3",
  "duracion": 34.24,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que tu móvil puede ser el mando de la tele?",
      "clave": "mando",
      "inicio": 0,
      "fin": 2.96
    },
    {
      "n": 2,
      "texto": "Sin pilas, y sin buscarlo por todo el salón.",
      "clave": "salón",
      "inicio": 3.04,
      "fin": 5.76
    },
    {
      "n": 3,
      "texto": "El mando le habla a la tele con una luz que tus ojos no ven.",
      "clave": "luz",
      "inicio": 5.84,
      "fin": 9.36
    },
    {
      "n": 4,
      "texto": "Pero muchas teles ya están conectadas al wifi de tu casa.",
      "clave": "wifi",
      "inicio": 9.4,
      "fin": 12.64
    },
    {
      "n": 5,
      "texto": "Y tu móvil también, así que pueden hablar entre ellos, sin luz y sin pilas.",
      "clave": "hablar",
      "inicio": 12.667,
      "fin": 17.52
    },
    {
      "n": 6,
      "texto": "Con una app, el móvil le manda las órdenes: enciende, sube el volumen, cambia de canal.",
      "clave": "órdenes",
      "inicio": 17.6,
      "fin": 22.96
    },
    {
      "n": 7,
      "texto": "Y el móvil siempre lo llevas encima: ese no se pierde.",
      "clave": "encima",
      "inicio": 22.987,
      "fin": 26.72
    },
    {
      "n": 8,
      "texto": "Descarga la app que tienes en el link de la bio, y pruébalo ahora mismo.",
      "clave": "app",
      "inicio": 26.84,
      "fin": 30.64
    },
    {
      "n": 9,
      "texto": "Y envíaselo a ese amigo que siempre pierde el mando.",
      "clave": "amigo",
      "inicio": 30.68,
      "fin": 33.44
    }
  ],
