{
  "firma": "534fa6f73457",
  "duracion": 51.68,
  "frases": [
    {
      "n": 1,
      "texto": "Why is your water heater banging?",
      "clave": "banging",
      "inicio": 0,
      "fin": 2.16
    },
    {
      "n": 2,
      "texto": "If it pops while it heats, chalk is trapping steam on the bottom.",
      "clave": "steam",
      "inicio": 2.2,
      "fin": 6
    },
    {
      "n": 3,
      "texto": "Shut a faucet and it bangs right then? That's the pipes. Call a plumber.",
      "clave": "pipes",
      "inicio": 6.08,
      "fin": 10.4
    },
    {
      "n": 4,
      "texto": "If it's gas, stop and call a plumber. Electric? Flip the breaker off.",
      "clave": "gas",
      "inicio": 10.44,
      "fin": 15.28
    },
    {
      "n": 5,
      "texto": "Shut the cold valve on the inlet pipe.",
      "clave": "valve",
      "inicio": 15.32,
      "fin": 17.44
    },
    {
      "n": 6,
      "texto": "Open a hot faucet upstairs, and leave it running.",
      "clave": "upstairs",
      "inicio": 17.56,
      "fin": 20.24
    },
    {
      "n": 7,
      "texto": "Now wait until the tank is cool.",
      "clave": "cool",
      "inicio": 20.36,
      "fin": 22.267
    },
    {
      "n": 8,
      "texto": "Hose on the drain, into a tub. Open the valve.",
      "clave": "hose",
      "inicio": 22.293,
      "fin": 25.52
    },
    {
      "n": 9,
      "texto": "Crack the cold valve. Blast it until the water runs clear. Then close the drain.",
      "clave": "clear",
      "inicio": 25.56,
      "fin": 30.88
    },
    {
      "n": 10,
      "texto": "Open that cold valve all the way.",
      "clave": "way",
      "inicio": 31,
      "fin": 33.2
    },
    {
      "n": 11,
      "texto": "Upstairs, the faucet stops spitting and runs steady.",
      "clave": "steady",
      "inicio": 33.28,
      "fin": 36.28
    },
    {
      "n": 12,
      "texto": "Only then do you flip the breaker back on.",
      "clave": "then",
      "inicio": 36.32,
      "fin": 38.68
    },
    {
      "n": 13,
      "texto": "Once a year. Hard water, every six months. Skip it, and the tank cooks itself.",
      "clave": "cooks",
      "inicio": 38.72,
      "fin": 44.027
    },
    {
      "n": 14,
      "texto": "Still banging, a leak, or eight years old? Call a pro.",
      "clave": "pro",
      "inicio": 44.133,
      "fin": 47.96
    },
    {
      "n": 15,
      "texto": "Send this to that friend whose water heater sounds like a kettle.",
      "clave": "kettle",
      "inicio": 48,
      "fin": 50.88
    }
  ],
