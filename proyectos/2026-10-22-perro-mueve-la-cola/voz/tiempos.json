{
  "firma": "66dfa9cfa511",
  "duracion": 46.8,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro mueve la cola más hacia un lado que hacia el otro?",
      "clave": "lado",
      "inicio": 0,
      "fin": 3.76
    },
    {
      "n": 2,
      "texto": "En treinta perros grabados, el meneo no llegaba igual de lejos a los dos lados.",
      "clave": "treinta",
      "inicio": 3.84,
      "fin": 8.32
    },
    {
      "n": 3,
      "texto": "Si te ve a ti, llega más lejos hacia su derecha.",
      "clave": "derecha",
      "inicio": 8.36,
      "fin": 11.44
    },
    {
      "n": 4,
      "texto": "Esa derecha la empuja la mitad izquierda de su cerebro, la del acercarse.",
      "clave": "izquierda",
      "inicio": 11.48,
      "fin": 15.92
    },
    {
      "n": 5,
      "texto": "Igual que tu mano derecha, que obedece a esa misma mitad.",
      "clave": "mano",
      "inicio": 15.96,
      "fin": 19.28
    },
    {
      "n": 6,
      "texto": "Si aparece un perro que no conoce y le impone, llega más lejos hacia su izquierda.",
      "clave": "impone",
      "inicio": 19.32,
      "fin": 24.24
    },
    {
      "n": 7,
      "texto": "Esa izquierda la empuja la otra mitad, la del apartarse.",
      "clave": "apartarse",
      "inicio": 24.28,
      "fin": 27.84
    },
    {
      "n": 8,
      "texto": "Y otro perro lo nota: si el meneo va más a la izquierda, se le acelera el corazón.",
      "clave": "corazón",
      "inicio": 27.88,
      "fin": 32.88
    },
    {
      "n": 9,
      "texto": "A simple vista casi no se aprecia: lo midieron en vídeo.",
      "clave": "vídeo",
      "inicio": 32.92,
      "fin": 36.4
    },
    {
      "n": 10,
      "texto": "Así que la cola no dice solo que está contento: dice si se acerca o se aparta.",
      "clave": "aparta",
      "inicio": 36.48,
      "fin": 41.52
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo al que su perro le mueve la cola y ya cree que está todo bien.",
      "clave": "bien",
      "inicio": 41.6,
      "fin": 46
    }
  ],
