{
  "firma": "35ca312a3ec7",
  "duracion": 44.8,
  "frases": [
    {
      "n": 1,
      "texto": "Why is your fridge leaking water all over the floor?",
      "clave": "leaking",
      "inicio": 0,
      "fin": 3.04
    },
    {
      "n": 2,
      "texto": "That puddle comes back once or twice a day, right in front of the door.",
      "clave": "twice",
      "inicio": 3.16,
      "fin": 6.96
    },
    {
      "n": 3,
      "texto": "Defrost meltwater should slip down a tiny hole into a pan under the fridge.",
      "clave": "hole",
      "inicio": 7.08,
      "fin": 11.72
    },
    {
      "n": 4,
      "texto": "Ice plugs that hole, so the water spills out the door instead.",
      "clave": "plugs",
      "inicio": 11.76,
      "fin": 15.52
    },
    {
      "n": 5,
      "texto": "First, unplug it, then pull out the bottom basket.",
      "clave": "unplug",
      "inicio": 15.68,
      "fin": 18.853
    },
    {
      "n": 6,
      "texto": "The hole is low on the back wall, dead center.",
      "clave": "center",
      "inicio": 18.907,
      "fin": 21.733
    },
    {
      "n": 7,
      "texto": "No hole, or ice all over the back wall? Call a technician.",
      "clave": "technician",
      "inicio": 21.787,
      "fin": 25.493
    },
    {
      "n": 8,
      "texto": "A leak behind the fridge is the water hose. Shut that valve.",
      "clave": "valve",
      "inicio": 25.547,
      "fin": 29.24
    },
    {
      "n": 9,
      "texto": "Stir a little baking soda into two cups of hot tap water, not boiling.",
      "clave": "soda",
      "inicio": 29.28,
      "fin": 33.48
    },
    {
      "n": 10,
      "texto": "A turkey baster shoots it in until you hear it splash in the pan underneath.",
      "clave": "splash",
      "inicio": 33.52,
      "fin": 37.56
    },
    {
      "n": 11,
      "texto": "Flush it once or twice a year, or the repair gets pricey.",
      "clave": "year",
      "inicio": 37.6,
      "fin": 40.92
    },
    {
      "n": 12,
      "texto": "Send this to that friend whose fridge keeps leaking on the floor.",
      "clave": "friend",
      "inicio": 40.96,
      "fin": 44
    }
  ],
