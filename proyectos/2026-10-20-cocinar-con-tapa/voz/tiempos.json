{
  "firma": "90cb25b03c34",
  "duracion": 37.6,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que cocinar sin tapa te sube la factura de la luz y del gas?",
      "clave": "factura",
      "inicio": 0,
      "fin": 3.68
    },
    {
      "n": 2,
      "texto": "Aunque subas el fuego al máximo, el agua nunca pasa de cien grados.",
      "clave": "cien",
      "inicio": 3.92,
      "fin": 7.92
    },
    {
      "n": 3,
      "texto": "Todo lo que le echas de más se escapa convertido en vapor.",
      "clave": "vapor",
      "inicio": 8,
      "fin": 10.84
    },
    {
      "n": 4,
      "texto": "Y cada gota que se va así se lleva más de cinco veces el calor que costó calentarla.",
      "clave": "cinco",
      "inicio": 11.04,
      "fin": 15.92
    },
    {
      "n": 5,
      "texto": "Ahora ponle la tapa.",
      "clave": "tapa",
      "inicio": 16,
      "fin": 17.44
    },
    {
      "n": 6,
      "texto": "El vapor choca contra ella, vuelve a ser agua y cae dentro, con todo su calor.",
      "clave": "dentro",
      "inicio": 17.48,
      "fin": 22.4
    },
    {
      "n": 7,
      "texto": "Así que, en cuanto hierva, bajas el fuego y sigue hirviendo igual.",
      "clave": "bajas",
      "inicio": 22.48,
      "fin": 26.4
    },
    {
      "n": 8,
      "texto": "Resultado: hasta un 25 % menos de gas o luz cada vez que cocinas.",
      "clave": "25",
      "inicio": 26.68,
      "fin": 31.2
    },
    {
      "n": 9,
      "texto": "Así que el secreto no es más fuego: es una tapa.",
      "clave": "tapa",
      "inicio": 31.28,
      "fin": 34.8
    },
    {
      "n": 10,
      "texto": "Sígueme para más consejos como este.",
      "clave": "Sígueme",
      "inicio": 34.827,
      "fin": 36.8
    }
  ],
