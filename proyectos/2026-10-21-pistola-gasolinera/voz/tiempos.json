{
  "firma": "fabf115d042e",
  "duracion": 50.48,
  "frases": [
    {
      "n": 1,
      "texto": "¿Cómo sabe la pistola de la gasolinera que tu depósito está lleno, si no tiene ni un cable?",
      "clave": "cable",
      "inicio": 0,
      "fin": 4.96
    },
    {
      "n": 2,
      "texto": "Y si sigues apretando cuando salta, lo paga tu coche.",
      "clave": "coche",
      "inicio": 5,
      "fin": 8.48
    },
    {
      "n": 3,
      "texto": "Una bomba bajo el suelo empuja la gasolina por la manguera hasta la pistola.",
      "clave": "bomba",
      "inicio": 8.56,
      "fin": 12.8
    },
    {
      "n": 4,
      "texto": "Y la gasolina pasa tan deprisa que chupa aire por un agujerito de la punta.",
      "clave": "agujerito",
      "inicio": 12.84,
      "fin": 17.36
    },
    {
      "n": 5,
      "texto": "Cuando la gasolina sube y tapa ese agujerito, ya no entra aire.",
      "clave": "tapa",
      "inicio": 17.4,
      "fin": 21.28
    },
    {
      "n": 6,
      "texto": "El vacío tira de una membrana, suelta un muelle y la pistola se cierra de golpe.",
      "clave": "golpe",
      "inicio": 21.32,
      "fin": 26.4
    },
    {
      "n": 7,
      "texto": "Si sigues apretando, llenas el hueco que el depósito guarda para los vapores.",
      "clave": "vapores",
      "inicio": 26.44,
      "fin": 30.72
    },
    {
      "n": 8,
      "texto": "Y la gasolina se mete en el filtro de carbón del coche, que solo aguanta vapor.",
      "clave": "carbón",
      "inicio": 30.747,
      "fin": 35.12
    },
    {
      "n": 9,
      "texto": "Se empapa, se estropea, y cambiarlo cuesta cientos de euros.",
      "clave": "cientos",
      "inicio": 35.16,
      "fin": 39.6
    },
    {
      "n": 10,
      "texto": "Así que no hay ningún cable: la propia gasolina cierra la pistola. En el primer clac, para.",
      "clave": "clac",
      "inicio": 39.68,
      "fin": 46
    },
    {
      "n": 11,
      "texto": "Envíaselo a ese amigo que siempre redondea hasta los cincuenta euros.",
      "clave": "cincuenta",
      "inicio": 46.08,
      "fin": 49.68
    }
  ],
