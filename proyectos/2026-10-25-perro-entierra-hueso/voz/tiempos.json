{
  "firma": "00fdfb765a90",
  "duracion": 37.76,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro entierra el hueso, si ya ha comido?",
      "clave": "hueso",
      "inicio": 0,
      "fin": 3
    },
    {
      "n": 2,
      "texto": "El plato está lleno, y él sigue cavando.",
      "clave": "lleno",
      "inicio": 3.2,
      "fin": 6.16
    },
    {
      "n": 3,
      "texto": "Eso lo hacen los lobos, cuando les sobra la presa.",
      "clave": "lobos",
      "inicio": 6.2,
      "fin": 8.92
    },
    {
      "n": 4,
      "texto": "Una loba escondió una pata a más de dos kilómetros.",
      "clave": "kilómetros",
      "inicio": 9.2,
      "fin": 12.32
    },
    {
      "n": 5,
      "texto": "Y dos hoyos de carne ya masticada, de más de medio kilo cada uno.",
      "clave": "kilo",
      "inicio": 12.36,
      "fin": 16.64
    },
    {
      "n": 6,
      "texto": "Lo filmaron en ocho lobos, más de ciento cincuenta veces.",
      "clave": "cincuenta",
      "inicio": 16.72,
      "fin": 20.56
    },
    {
      "n": 7,
      "texto": "El hoyo, siempre con las patas de delante.",
      "clave": "patas",
      "inicio": 20.64,
      "fin": 23.2
    },
    {
      "n": 8,
      "texto": "Taparlo, siempre con el hocico.",
      "clave": "hocico",
      "inicio": 23.28,
      "fin": 25.44
    },
    {
      "n": 9,
      "texto": "Tu perro hace ese gesto, aunque ya esté lleno.",
      "clave": "gesto",
      "inicio": 25.48,
      "fin": 28.32
    },
    {
      "n": 10,
      "texto": "Y si no hay tierra, lo empuja bajo el cojín.",
      "clave": "cojín",
      "inicio": 28.36,
      "fin": 30.8
    },
    {
      "n": 11,
      "texto": "Lo guarda para comérselo luego.",
      "clave": "luego",
      "inicio": 30.84,
      "fin": 32.8
    },
    {
      "n": 12,
      "texto": "Envíaselo a ese amigo al que su perro le entierra los calcetines detrás del sofá.",
      "clave": "calcetines",
      "inicio": 32.92,
      "fin": 36.96
    }
  ],
