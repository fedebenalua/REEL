{
  "firma": "9a6270a2e399",
  "duracion": 41.44,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro tiene miedo a los petardos?",
      "clave": "petardos",
      "inicio": 0,
      "fin": 2.44
    },
    {
      "n": 2,
      "texto": "Casi la mitad da alguna señal.",
      "clave": "señal",
      "inicio": 2.72,
      "fin": 4.64
    },
    {
      "n": 3,
      "texto": "Y solo uno de cada cuatro lo llama miedo.",
      "clave": "cuatro",
      "inicio": 5.04,
      "fin": 7.52
    },
    {
      "n": 4,
      "texto": "No es miedo a todo.",
      "clave": "todo",
      "inicio": 8,
      "fin": 9.04
    },
    {
      "n": 5,
      "texto": "El petardo, el trueno y el disparo van juntos.",
      "clave": "juntos",
      "inicio": 9.44,
      "fin": 12.48
    },
    {
      "n": 6,
      "texto": "En los que lo tienen, casi la mitad empieza antes de cumplir el año.",
      "clave": "año",
      "inicio": 12.72,
      "fin": 16.48
    },
    {
      "n": 7,
      "texto": "A la mañana siguiente, tres de cada cuatro ya está bien.",
      "clave": "bien",
      "inicio": 16.72,
      "fin": 19.84
    },
    {
      "n": 8,
      "texto": "A unos pocos les dura semanas.",
      "clave": "semanas",
      "inicio": 20.08,
      "fin": 21.76
    },
    {
      "n": 9,
      "texto": "Si nadie pide ayuda, a la mitad se le queda igual.",
      "clave": "igual",
      "inicio": 22.24,
      "fin": 24.8
    },
    {
      "n": 10,
      "texto": "Tres de cada diez mejoran.",
      "clave": "mejoran",
      "inicio": 25.28,
      "fin": 26.72
    },
    {
      "n": 11,
      "texto": "Y uno de cada cinco empeora.",
      "clave": "empeora",
      "inicio": 27.12,
      "fin": 29.2
    },
    {
      "n": 12,
      "texto": "Si el ruido llega con algo bueno antes del miedo, baja mucho.",
      "clave": "bueno",
      "inicio": 29.52,
      "fin": 32.72
    },
    {
      "n": 13,
      "texto": "Empezar cuando ya lo tiene no se notaba igual.",
      "clave": "notaba",
      "inicio": 33.12,
      "fin": 35.76
    },
    {
      "n": 14,
      "texto": "Envíaselo a ese amigo al que su perro se mete debajo del sofá en cuanto oye un petardo.",
      "clave": "sofá",
      "inicio": 36,
      "fin": 40.64
    }
  ],
