{
  "firma": "c26d8ed72ce9",
  "duracion": 48.08,
  "frases": [
    {
      "n": 1,
      "texto": "Outlet not working? Check this first.",
      "clave": "outlet",
      "inicio": 0,
      "fin": 2.72
    },
    {
      "n": 2,
      "texto": "Your breakers can all look fine. The button that cut it is often in another room.",
      "clave": "button",
      "inicio": 2.8,
      "fin": 7.52
    },
    {
      "n": 3,
      "texto": "A GFCI shuts off when a little current leaks, and it kills every outlet wired after it.",
      "clave": "leaks",
      "inicio": 7.6,
      "fin": 13.2
    },
    {
      "n": 4,
      "texto": "Unplug everything there, and try a lamp you know works.",
      "clave": "lamp",
      "inicio": 13.28,
      "fin": 16.48
    },
    {
      "n": 5,
      "texto": "If you see Test and Reset, press Reset until it clicks.",
      "clave": "clicks",
      "inicio": 16.56,
      "fin": 20.64
    },
    {
      "n": 6,
      "texto": "No buttons? Check the bath, the kitchen, the garage, and near water. Press the one sticking out.",
      "clave": "sticking",
      "inicio": 20.72,
      "fin": 26.96
    },
    {
      "n": 7,
      "texto": "Still dead? Unplug what's on it, push the breaker all the way off, then on.",
      "clave": "breaker",
      "inicio": 27.08,
      "fin": 32
    },
    {
      "n": 8,
      "texto": "Don't open the outlet. If it's hot, black, or buzzing, or it will not stay on, leave the breaker off and call an electrician.",
      "clave": "electrician",
      "inicio": 32.08,
      "fin": 39.84
    },
    {
      "n": 9,
      "texto": "That press takes ten seconds. Calling someone to press it can cost a full hour.",
      "clave": "hour",
      "inicio": 39.92,
      "fin": 44.88
    },
    {
      "n": 10,
      "texto": "Send this to that friend whose outlet just died.",
      "clave": "friend",
      "inicio": 44.96,
      "fin": 47.28
    }
  ],
