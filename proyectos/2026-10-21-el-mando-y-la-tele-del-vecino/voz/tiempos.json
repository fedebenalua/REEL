{
  "firma": "83f581d1087b",
  "duracion": 40.16,
  "frases": [
    {
      "n": 1,
      "texto": "Your TV remote was almost going to change the channel next door.",
      "clave": "door",
      "inicio": 0,
      "fin": 3.84
    },
    {
      "n": 2,
      "texto": "Radio goes through the wall, so one press would flip both TVs.",
      "clave": "wall",
      "inicio": 3.92,
      "fin": 8
    },
    {
      "n": 3,
      "texto": "So they built a click the wall could stop.",
      "clave": "click",
      "inicio": 8.16,
      "fin": 10.64
    },
    {
      "n": 4,
      "texto": "A tiny hammer hit a metal rod, about as long as your thumb.",
      "clave": "thumb",
      "inicio": 10.72,
      "fin": 14.32
    },
    {
      "n": 5,
      "texto": "Four notes, too high to hear: next channel, last channel, mute, and off.",
      "clave": "notes",
      "inicio": 14.4,
      "fin": 20
    },
    {
      "n": 6,
      "texto": "No batteries. If they died, you'd think the TV was broken.",
      "clave": "batteries",
      "inicio": 20.08,
      "fin": 23.6
    },
    {
      "n": 7,
      "texto": "Nine million TVs listened to that click for twenty five years.",
      "clave": "million",
      "inicio": 23.68,
      "fin": 27.8
    },
    {
      "n": 8,
      "texto": "Then the click became a light you can't see, and you have to point it.",
      "clave": "light",
      "inicio": 27.84,
      "fin": 31.653
    },
    {
      "n": 9,
      "texto": "Your phone is radio again, but only for the TV in your house.",
      "clave": "phone",
      "inicio": 31.707,
      "fin": 35.32
    },
    {
      "n": 10,
      "texto": "The app is in the link in bio.",
      "clave": "app",
      "inicio": 35.36,
      "fin": 37.093
    },
    {
      "n": 11,
      "texto": "Send it to that friend who keeps losing the remote.",
      "clave": "friend",
      "inicio": 37.147,
      "fin": 39.36
    }
  ],
