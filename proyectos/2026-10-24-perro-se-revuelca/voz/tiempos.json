{
  "firma": "01d0f5897b21",
  "duracion": 43.12,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro se revuelca en cosas que huelen fatal?",
      "clave": "fatal",
      "inicio": 0,
      "fin": 3.24
    },
    {
      "n": 2,
      "texto": "Dicen que se disfraza, para cazar sin que lo huelan.",
      "clave": "disfraza",
      "inicio": 3.52,
      "fin": 6.56
    },
    {
      "n": 3,
      "texto": "Pues en el ochenta y seis, a quince lobos les pusieron perfume.",
      "clave": "perfume",
      "inicio": 6.6,
      "fin": 10.56
    },
    {
      "n": 4,
      "texto": "Caca de oveja y de caballo: ni se rozaron.",
      "clave": "rozaron",
      "inicio": 10.6,
      "fin": 13.6
    },
    {
      "n": 5,
      "texto": "Perfume y aceite de coche: se tiraron de espaldas.",
      "clave": "espaldas",
      "inicio": 13.72,
      "fin": 17.04
    },
    {
      "n": 6,
      "texto": "Lo segundo fue caca de puma y de oso.",
      "clave": "puma",
      "inicio": 17.08,
      "fin": 19.68
    },
    {
      "n": 7,
      "texto": "Un disfraz de caza no huele a perfume.",
      "clave": "caza",
      "inicio": 19.76,
      "fin": 22.48
    },
    {
      "n": 8,
      "texto": "Años después, en un zoo, también se revolcaron en curry y en lana.",
      "clave": "curry",
      "inicio": 22.52,
      "fin": 26.88
    },
    {
      "n": 9,
      "texto": "El motivo exacto sigue abierto.",
      "clave": "abierto",
      "inicio": 26.92,
      "fin": 28.96
    },
    {
      "n": 10,
      "texto": "Lo que sí eligen es el olor raro, aunque a ti te huela fatal.",
      "clave": "raro",
      "inicio": 29,
      "fin": 33.12
    },
    {
      "n": 11,
      "texto": "Así que no se disfraza para cazar: se pone un olor que no había olido.",
      "clave": "olido",
      "inicio": 33.2,
      "fin": 37.92
    },
    {
      "n": 12,
      "texto": "Envíaselo a ese amigo al que su perro vuelve del parque oliendo a algo innombrable.",
      "clave": "innombrable",
      "inicio": 38,
      "fin": 42.32
    }
  ],
