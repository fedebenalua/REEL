{
  "firma": "27c1fc359620",
  "duracion": 45.84,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro te trae el juguete y no te lo suelta?",
      "clave": "juguete",
      "inicio": 0,
      "fin": 3.04
    },
    {
      "n": 2,
      "texto": "No te lo regala. Te está llamando a jugar.",
      "clave": "jugar",
      "inicio": 3.08,
      "fin": 5.8
    },
    {
      "n": 3,
      "texto": "Con otro perro, si gana la cuerda, casi no la suelta.",
      "clave": "cuerda",
      "inicio": 6.08,
      "fin": 9.2
    },
    {
      "n": 4,
      "texto": "Contigo la suelta mucho más, para que el juego siga.",
      "clave": "sigue",
      "inicio": 9.36,
      "fin": 12.4
    },
    {
      "n": 5,
      "texto": "Lo vieron en labradores, con la misma cuerda anudada.",
      "clave": "labradores",
      "inicio": 12.72,
      "fin": 15.52
    },
    {
      "n": 6,
      "texto": "Si hay dos juguetes, cada perro se queda el suyo.",
      "clave": "suyo",
      "inicio": 16,
      "fin": 18.48
    },
    {
      "n": 7,
      "texto": "Si el otro eres tú, ignora el que está libre.",
      "clave": "libre",
      "inicio": 18.88,
      "fin": 21.68
    },
    {
      "n": 8,
      "texto": "El premio no es el juguete. Eres tú.",
      "clave": "tú",
      "inicio": 21.72,
      "fin": 24.08
    },
    {
      "n": 9,
      "texto": "Y si aun así no lo suelta, no es que mande.",
      "clave": "mande",
      "inicio": 24.64,
      "fin": 27.12
    },
    {
      "n": 10,
      "texto": "Catorce golden retriever.",
      "clave": "catorce",
      "inicio": 27.92,
      "fin": 29.84
    },
    {
      "n": 11,
      "texto": "Veinte partidas ganadas, y veinte perdidas.",
      "clave": "veinte",
      "inicio": 29.88,
      "fin": 32.4
    },
    {
      "n": 12,
      "texto": "Ganar no cambió quién mandaba.",
      "clave": "mandaba",
      "inicio": 32.8,
      "fin": 34.56
    },
    {
      "n": 13,
      "texto": "Los diez más juguetones pedían más juego después de ganar.",
      "clave": "juego",
      "inicio": 35.04,
      "fin": 38.44
    },
    {
      "n": 14,
      "texto": "Te lo pone delante para que no pares.",
      "clave": "delante",
      "inicio": 38.72,
      "fin": 40.96
    },
    {
      "n": 15,
      "texto": "Envíaselo a ese amigo al que su perro le acerca la pelota y sale corriendo.",
      "clave": "pelota",
      "inicio": 41.08,
      "fin": 45.04
    }
  ],
