{
  "firma": "a6477405487d",
  "duracion": 48.72,
  "frases": [
    {
      "n": 1,
      "texto": "¿Sabías que el mar Mediterráneo llegó a secarse casi por completo?",
      "clave": "secarse",
      "inicio": 0,
      "fin": 4.24
    },
    {
      "n": 2,
      "texto": "Se cerró el paso al Atlántico, y el sol se quedó con el mar.",
      "clave": "cerró",
      "inicio": 4.28,
      "fin": 8.08
    },
    {
      "n": 3,
      "texto": "Hoy el océano entra por ese paso y repone lo que el sol se bebe.",
      "clave": "océano",
      "inicio": 8.16,
      "fin": 12.16
    },
    {
      "n": 4,
      "texto": "Sin esa entrada, el mar baja medio metro cada año: una bañera.",
      "clave": "bañera",
      "inicio": 12.24,
      "fin": 16.68
    },
    {
      "n": 5,
      "texto": "Hace unos seis millones de años, en el este se fue la mayor parte del agua y el nivel cayó más de un kilómetro y medio.",
      "clave": "kilómetro",
      "inicio": 17.12,
      "fin": 24.24
    },
    {
      "n": 6,
      "texto": "Pero no hasta el polvo: en el fondo quedó un lago de sal de más de un kilómetro.",
      "clave": "lago",
      "inicio": 24.293,
      "fin": 28.96
    },
    {
      "n": 7,
      "texto": "Esa sal cubriría España con una capa de casi dos kilómetros.",
      "clave": "España",
      "inicio": 29,
      "fin": 33.2
    },
    {
      "n": 8,
      "texto": "Cuando el Atlántico volvió, hay quien calcula más de diez metros al día, aunque no todos lo ven tan rápido.",
      "clave": "diez",
      "inicio": 33.24,
      "fin": 39.68
    },
    {
      "n": 9,
      "texto": "Así que no se vació del todo: dejó un lago de sal, y el océano lo llenó otra vez.",
      "clave": "llenó",
      "inicio": 39.76,
      "fin": 45.28
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo que se baña ahí cada verano.",
      "clave": "amigo",
      "inicio": 45.36,
      "fin": 47.92
    }
  ],
