{
  "firma": "17bb8aaf4db4",
  "duracion": 42.4,
  "frases": [
    {
      "n": 1,
      "texto": "Why is there a wet spot on my ceiling?",
      "clave": "ceiling",
      "inicio": 0,
      "fin": 2.4
    },
    {
      "n": 2,
      "texto": "That ring is where the water fell. It ran along the wood first.",
      "clave": "wood",
      "inicio": 2.48,
      "fin": 6.4
    },
    {
      "n": 3,
      "texto": "On a dry day, with the air conditioner on, slime has clogged its drain, and the pan is spilling.",
      "clave": "slime",
      "inicio": 6.48,
      "fin": 12.24
    },
    {
      "n": 4,
      "texto": "Stay out from under a bulge. Water on a light? Don't touch the switch.",
      "clave": "bulge",
      "inicio": 12.36,
      "fin": 16.76
    },
    {
      "n": 5,
      "texto": "Turn the air conditioner off. That stops new water.",
      "clave": "off",
      "inicio": 16.96,
      "fin": 20.24
    },
    {
      "n": 6,
      "texto": "Outside, seal a shop vac on the little white pipe and pull the slime out.",
      "clave": "pull",
      "inicio": 20.52,
      "fin": 24.8
    },
    {
      "n": 7,
      "texto": "Don't push it in with a hose. Later, half a cup of white vinegar down the line. Never with bleach.",
      "clave": "vinegar",
      "inicio": 24.84,
      "fin": 31.12
    },
    {
      "n": 8,
      "texto": "Wet after rain, under a bathroom, or still sagging? Stay off the roof and call a pro.",
      "clave": "roof",
      "inicio": 31.2,
      "fin": 36.8
    },
    {
      "n": 9,
      "texto": "Want the full step-by-step for any problem at home? Our tool is in the link in bio.",
      "clave": "bio",
      "inicio": 36.88,
      "fin": 41.6
    }
  ],
