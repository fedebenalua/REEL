{
  "firma": "ed9c57e8a916",
  "duracion": 37.44,
  "frases": [
    {
      "n": 1,
      "texto": "¿Por qué tu perro patalea cuando le rascas la barriga?",
      "clave": "barriga",
      "inicio": 0,
      "fin": 2.96
    },
    {
      "n": 2,
      "texto": "Parece que le hace tanta gracia que se le va la pata.",
      "clave": "gracia",
      "inicio": 3.04,
      "fin": 6.16
    },
    {
      "n": 3,
      "texto": "No es el centro de la barriga: es el costado, donde llega su pata de atrás.",
      "clave": "costado",
      "inicio": 6.32,
      "fin": 10.88
    },
    {
      "n": 4,
      "texto": "Ese toque baja a la médula, y ella dispara la pata de ese mismo lado.",
      "clave": "médula",
      "inicio": 10.92,
      "fin": 15.04
    },
    {
      "n": 5,
      "texto": "Unas cuatro veces por segundo.",
      "clave": "cuatro",
      "inicio": 15.08,
      "fin": 17.12
    },
    {
      "n": 6,
      "texto": "Si rascas más fuerte, la pata no va más deprisa: va más lejos.",
      "clave": "lejos",
      "inicio": 17.16,
      "fin": 21.36
    },
    {
      "n": 7,
      "texto": "Como cuando te dan en la rodilla y la pierna salta sola.",
      "clave": "rodilla",
      "inicio": 21.44,
      "fin": 24.32
    },
    {
      "n": 8,
      "texto": "No hace falta el cerebro: la médula sola lanza la pata.",
      "clave": "cerebro",
      "inicio": 24.36,
      "fin": 28
    },
    {
      "n": 9,
      "texto": "Así que no se está riendo: la pata va a rascar el sitio que tocas tú.",
      "clave": "rascar",
      "inicio": 28.08,
      "fin": 32.48
    },
    {
      "n": 10,
      "texto": "Envíaselo a ese amigo al que su perro le pega patadas en cuanto le toca la tripita.",
      "clave": "patadas",
      "inicio": 32.6,
      "fin": 36.64
    }
  ],
